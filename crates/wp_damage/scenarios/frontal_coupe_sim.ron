// The coupe lattice (different profile, mass and dimensions) must meet the same frontal
// calibration as the sedan: sections scale with car mass.
(
    name: "frontal_coupe_sim",
    car: "debug_coupe",
    mode: Simulation,
    impact: Frontal,
    other_mass_kg: 0.0,
    duration_s: 0.5,
    seed: 2,
    monotone: ["crush_m", "plastic_energy_kj", "damage"],
    runs: [
        (speed_kmh: 25.0, expect: [(metric: "crush_m", min: 0.05, max: 0.3)], intact: [Radiator, Engine], cracked: [FrontBumper], total_loss: Some(false)),
        (speed_kmh: 56.0, expect: [(metric: "crush_m", min: 0.45, max: 0.75)], failed: [Radiator], total_loss: Some(true)),
        (speed_kmh: 80.0, expect: [(metric: "crush_m", min: 0.75, max: 1.6)], failed: [Engine], total_loss: Some(true)),
    ],
)
