// Same as day_core_speeder.ron, on wp_world's procedural city (ProcGenConfig::small, converted
// with RoadGraph::from_city; line of sight from its building footprints).
(
    name: "police_world_day_core_speeder",
    seed: 100,
    world_city: true,
    time_of_day_h: 12.0,
    duration_s: 180.0,
    runs: 5,
    racers: [(district: Core, speed_factor: 2.0)],
    expect: [
        (metric: "pursuit_start_max_s", min: 0.0, max: 20.0),
        (metric: "patrols_core", min: 8.0, max: 8.0),
        (metric: "reinforcements", min: 1.0, max: 1000.0),
        (metric: "min_tool_sight_m", min: 120.0, max: 10000.0),
    ],
)
