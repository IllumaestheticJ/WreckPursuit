// 20 scripted pursuits in Simulation damage: at most 10% of engaged units total-loss
// themselves without racer contact (risk budget + conservative corner planning).
// Re-aimed 2026-10-23 (row 158): the spawn view check along every road the racer can take
// changes the spawn draws; 23 -> 24 self-wrecks of 240 engaged units (9.6% -> 10.0%), one
// unit, inside run-to-run noise (about +-2 points at this sample size).
(
    name: "police_self_wreck_sim",
    seed: 200,
    mode: Simulation,
    time_of_day_h: 12.0,
    duration_s: 120.0,
    runs: 20,
    racers: [(district: Core, speed_factor: 2.2, initial_heat: 35.0, stay_in_district: false)],
    expect: [
        (metric: "pursuits", min: 20.0, max: 1000.0),
        (metric: "units_engaged", min: 20.0, max: 10000.0),
        (metric: "self_wreck_rate", min: 0.0, max: 0.1001),
    ],
)
