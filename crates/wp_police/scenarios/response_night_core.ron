// Lead feedback round 12b (owner: "the police spawn too far"): a racer doing 2x the limit
// through Core at 23:00. Checks the call -> first unit within 100 m time and that no unit appears
// in a racer's view cone or closer than 120 m.
(
    name: "police_response_night_core",
    seed: 300,
    time_of_day_h: 23.0,
    duration_s: 60.0,
    runs: 8,
    racers: [(district: Core, speed_factor: 2.0)],
    expect: [
        (metric: "calls", min: 1.0, max: 10000.0),
        (metric: "call_to_unit_100m_s", min: 0.0, max: 25.0),
        (metric: "call_to_unit_100m_max_s", min: 0.0, max: 50.0),
        (metric: "responder_spawns", min: 1.0, max: 1000.0),
        (metric: "spawns_in_view", min: 0.0, max: 0.0),
        (metric: "despawns_in_sight", min: 0.0, max: 0.0),
        (metric: "spawn_min_racer_m", min: 120.0, max: 10000.0),
    ],
)
