// Lead feedback round 12b (owner: "the police spawn too far"): a racer doing 2x the limit
// through Core at 12:00. Each unseen violation is a reckless-driving call; dispatch sends an
// available unit that can meet the racer within response.radius_m, or spawns a responder out
// of sight 150-350 m away along the roads (data/police/presence.toml [response]). Checks the
// call -> first unit within 100 m time and that no unit appears in a racer's view cone or
// closer than 120 m.
(
    name: "police_response_day_core",
    seed: 300,
    time_of_day_h: 12.0,
    duration_s: 60.0,
    runs: 8,
    racers: [(district: Core, speed_factor: 2.0)],
    expect: [
        (metric: "calls", min: 1.0, max: 10000.0),
        (metric: "call_reached_25s_frac", min: 0.875, max: 1.0),
        (metric: "call_to_unit_100m_s", min: 0.0, max: 10.0),
        // 2026-10-23: responders plan on the reported position and velocity, not the racer's
        // real one: worst of 3 calls 8.3 -> 19.5 s (mean 4.2 -> 7.0 s), inside presence.toml's
        // 10-25 s target for Core by day.
        (metric: "call_to_unit_100m_max_s", min: 0.0, max: 25.0),
        (metric: "spawns_in_view", min: 0.0, max: 0.0),
        (metric: "despawns_in_sight", min: 0.0, max: 0.0),
        (metric: "spawn_min_racer_m", min: 120.0, max: 10000.0),
    ],
)
