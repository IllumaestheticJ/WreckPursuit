// Same racer at 03:00: sparse patrols, short witness range. Pursuit takes longer than 25 s on
// average (a patrol can still happen to be right there; was 60 s before round 12b, when
// reckless-driving calls started getting a responder within seconds and blatant pass-bys
// started a pursuit at once) and reinforcements arrive slower (ratios asserted in
// tests/police_scenarios.rs).
(
    name: "police_night_core_speeder",
    seed: 100,
    time_of_day_h: 3.0,
    duration_s: 480.0,
    runs: 8,
    racers: [(district: Core, speed_factor: 2.0)],
    expect: [
        (metric: "pursuit_start_s", min: 25.0, max: 10000.0),
    ],
)
