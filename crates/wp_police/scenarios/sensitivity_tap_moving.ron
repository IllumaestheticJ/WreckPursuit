// Sensitivity: a law-abiding driver scrapes a civilian once at 50 km/h, nobody in uniform sees
// it. Before 2026-10-23 the call stayed open for 180 s, was dispatched again every 6 s and kept
// spawning responders that chased the (never wanted) driver around with sirens. Now: heat
// 1.6 (unseen), one call, dispatched again at most twice, dropped 60 s after the report.
// At 03:00 in the Suburb, where no patrol is likely to see the scrape itself.
(
    name: "police_sensitivity_tap_moving",
    seed: 910,
    time_of_day_h: 3.0,
    duration_s: 180.0,
    runs: 3,
    racers: [(district: Suburb, speed_factor: 0.95, violations: false, tap_at_s: Some(20.0))],
    expect: [
        (metric: "calls", min: 0, max: 3),
        (metric: "call_open_s", min: 0, max: 70),
        (metric: "responder_spawns", min: 0, max: 3),
        (metric: "max_wanted_level", min: 0, max: 0),
        (metric: "pursuits", min: 0, max: 0),
    ],
)
