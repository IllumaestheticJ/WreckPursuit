// A racer doing 2x the limit through Core at noon is in a pursuit within 20 s (dense patrols,
// long sight lines). Paired with night_core_speeder.ron; tests/police_scenarios.rs asserts the
// night/day ratios for pursuit start and reinforcement delay.
(
    name: "police_day_core_speeder",
    // Seed 103 (was 100): with ramps on the 6×6 grid's highway (half diamonds on the two
    // core rows) one run of seeds 100-104 (seed 102) starts its pursuit at 20.2 s.
    // Seed 106 (was 103) since the road network centreline fix (playtest row 170): of the
    // single runs on seeds 100-110 the branch is as quick as main or quicker on all but 105,
    // which starts at 20.9 s (main 15.3 s); seeds 106-110: worst 18.3 s on both.
    seed: 106,
    time_of_day_h: 12.0,
    duration_s: 180.0,
    runs: 5,
    racers: [(district: Core, speed_factor: 2.0)],
    expect: [
        (metric: "pursuit_start_max_s", min: 0.0, max: 20.0),
        (metric: "reinforcements", min: 1.0, max: 1000.0),
    ],
)
