// Wanted racer stops while pursued: captured (stopped < 2 m/s for 4 s with a unit within 15 m).
(
    name: "police_capture_stop",
    seed: 400,
    time_of_day_h: 12.0,
    duration_s: 120.0,
    runs: 3,
    stop_after_first_pursuit: true,
    racers: [(district: Core, speed_factor: 1.3, initial_heat: 15.0, stop_at_s: Some(45.0))],
    expect: [
        (metric: "captures", min: 3.0, max: 3.0),
        (metric: "escapes", min: 0.0, max: 0.0),
    ],
)
