{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerToClient",
  "description": "Messages from the server to a client.",
  "oneOf": [
    {
      "description": "Per-tick (60 Hz) snapshot.",
      "type": "object",
      "properties": {
        "Snapshot": {
          "type": "object",
          "properties": {
            "events": {
              "description": "Events since the last snapshot.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/SimEvent"
              }
            },
            "tick": {
              "description": "Physics tick of the snapshot.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "vehicles": {
              "description": "Visible vehicles, ascending by entity id.",
              "type": "array",
              "items": {
                "type": "array",
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "$ref": "#/$defs/EntityId"
                  },
                  {
                    "$ref": "#/$defs/VehicleState"
                  }
                ]
              }
            }
          },
          "required": [
            "tick",
            "vehicles",
            "events"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "Snapshot"
      ]
    },
    {
      "description": "Full baseline on join / after desync; encoding defined by `wp_net` (opaque here).",
      "type": "object",
      "properties": {
        "Baseline": {
          "type": "object",
          "properties": {
            "payload": {
              "description": "Encoded baseline.",
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              }
            },
            "tick": {
              "description": "Physics tick of the baseline.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "tick",
            "payload"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "Baseline"
      ]
    },
    {
      "description": "The server assigned a role.",
      "type": "object",
      "properties": {
        "RoleAssigned": {
          "type": "object",
          "properties": {
            "player": {
              "description": "The player.",
              "$ref": "#/$defs/PlayerId"
            },
            "role": {
              "description": "Assigned role.",
              "$ref": "#/$defs/Role"
            },
            "vehicle": {
              "description": "Vehicle controlled by the player, if any.",
              "anyOf": [
                {
                  "$ref": "#/$defs/EntityId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "player",
            "role"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "RoleAssigned"
      ]
    }
  ],
  "$defs": {
    "Component": {
      "description": "Mechanical component that can be damaged by intrusion.",
      "oneOf": [
        {
          "description": "Engine block.",
          "type": "string",
          "const": "Engine"
        },
        {
          "description": "Radiator / cooling pack.",
          "type": "string",
          "const": "Radiator"
        },
        {
          "description": "Battery.",
          "type": "string",
          "const": "Battery"
        },
        {
          "description": "Fuel tank.",
          "type": "string",
          "const": "FuelTank"
        },
        {
          "description": "Steering rack.",
          "type": "string",
          "const": "SteeringRack"
        },
        {
          "description": "Front-left suspension mount / arms.",
          "type": "string",
          "const": "SuspensionFL"
        },
        {
          "description": "Front-right suspension mount / arms.",
          "type": "string",
          "const": "SuspensionFR"
        },
        {
          "description": "Rear-left suspension mount / arms.",
          "type": "string",
          "const": "SuspensionRL"
        },
        {
          "description": "Rear-right suspension mount / arms.",
          "type": "string",
          "const": "SuspensionRR"
        },
        {
          "description": "Front-left wheel / hub attachment.",
          "type": "string",
          "const": "WheelFL"
        },
        {
          "description": "Front-right wheel / hub attachment.",
          "type": "string",
          "const": "WheelFR"
        },
        {
          "description": "Rear-left wheel / hub attachment.",
          "type": "string",
          "const": "WheelRL"
        },
        {
          "description": "Rear-right wheel / hub attachment.",
          "type": "string",
          "const": "WheelRR"
        },
        {
          "description": "Gearbox.",
          "type": "string",
          "const": "Gearbox"
        },
        {
          "description": "Driveshaft / half-shafts.",
          "type": "string",
          "const": "Driveshaft"
        },
        {
          "description": "Front-left brake.",
          "type": "string",
          "const": "BrakeFL"
        },
        {
          "description": "Front-right brake.",
          "type": "string",
          "const": "BrakeFR"
        },
        {
          "description": "Rear-left brake.",
          "type": "string",
          "const": "BrakeRL"
        },
        {
          "description": "Rear-right brake.",
          "type": "string",
          "const": "BrakeRR"
        },
        {
          "description": "Exhaust system.",
          "type": "string",
          "const": "Exhaust"
        },
        {
          "description": "Head and tail lights (cosmetic + night visibility).",
          "type": "string",
          "const": "Lights"
        }
      ]
    },
    "DamageMode": {
      "description": "Damage mode. Both modes run the same code path with different [`crate::ModeTable`]s.",
      "oneOf": [
        {
          "description": "Punishing but survivable; one hard hit degrades, several end the car.",
          "type": "string",
          "const": "Arcade"
        },
        {
          "description": "Real-world-ish; one hard hit at speed is a total loss.",
          "type": "string",
          "const": "Simulation"
        }
      ]
    },
    "EntityId": {
      "description": "Simulation entity identifier (vehicles, debris, police units, traffic agents).\nAllocated by `wp_sim`, never reused within one instance.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "PlayerId": {
      "description": "Human player identifier, allocated by `wp_net` on connect.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "Role": {
      "description": "Role a human player holds in an instance.",
      "oneOf": [
        {
          "description": "Street racer driving their own car.",
          "type": "string",
          "const": "Racer"
        },
        {
          "description": "The single police captain: map view, dispatch, tools. Does not drive.",
          "type": "string",
          "const": "PoliceCaptain"
        },
        {
          "description": "Player-driven police chase unit.",
          "type": "string",
          "const": "PoliceChase"
        },
        {
          "description": "Observer with no vehicle.",
          "type": "string",
          "const": "Spectator"
        }
      ]
    },
    "SimEvent": {
      "description": "Every event the simulation can emit.",
      "oneOf": [
        {
          "description": "Rigid-body contact between two entities (or an entity and the world).",
          "type": "object",
          "properties": {
            "Contact": {
              "type": "object",
              "properties": {
                "a": {
                  "description": "First entity.",
                  "$ref": "#/$defs/EntityId"
                },
                "b": {
                  "description": "Second entity (`EntityId(u32::MAX)` = static world).",
                  "$ref": "#/$defs/EntityId"
                },
                "impulse_ns": {
                  "description": "Normal impulse magnitude, N·s.",
                  "type": "number",
                  "format": "float"
                },
                "normal": {
                  "description": "Unit contact normal in world space (from `a` toward `b`).",
                  "type": "array",
                  "items": {
                    "type": "number",
                    "format": "float"
                  },
                  "maxItems": 3,
                  "minItems": 3
                },
                "point": {
                  "description": "Contact point in world space, m.",
                  "type": "array",
                  "items": {
                    "type": "number",
                    "format": "float"
                  },
                  "maxItems": 3,
                  "minItems": 3
                },
                "rel_speed": {
                  "description": "Relative closing speed, m/s.",
                  "type": "number",
                  "format": "float"
                }
              },
              "required": [
                "a",
                "b",
                "point",
                "normal",
                "impulse_ns",
                "rel_speed"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Contact"
          ]
        },
        {
          "description": "Lattice node displacement deltas. **Debug / replay only**; never sent over the network.",
          "type": "object",
          "properties": {
            "LatticeDeformed": {
              "type": "object",
              "properties": {
                "nodes_delta": {
                  "description": "`(node id, displacement delta in chassis space m)`.",
                  "type": "array",
                  "items": {
                    "type": "array",
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "integer",
                        "format": "uint16",
                        "maximum": 65535,
                        "minimum": 0
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "format": "float"
                        },
                        "maxItems": 3,
                        "minItems": 3
                      }
                    ]
                  }
                },
                "vehicle": {
                  "description": "Deformed vehicle.",
                  "$ref": "#/$defs/EntityId"
                }
              },
              "required": [
                "vehicle",
                "nodes_delta"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "LatticeDeformed"
          ]
        },
        {
          "description": "A detachable part group tore off.",
          "type": "object",
          "properties": {
            "PartDetached": {
              "type": "object",
              "properties": {
                "group": {
                  "description": "`Detachable::group` id.",
                  "type": "integer",
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0
                },
                "vehicle": {
                  "description": "Vehicle the part came from.",
                  "$ref": "#/$defs/EntityId"
                }
              },
              "required": [
                "vehicle",
                "group"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "PartDetached"
          ]
        },
        {
          "description": "A component's health changed noticeably (emitters should threshold, not spam).",
          "type": "object",
          "properties": {
            "ComponentDamaged": {
              "type": "object",
              "properties": {
                "component": {
                  "description": "Component.",
                  "$ref": "#/$defs/Component"
                },
                "health": {
                  "description": "New health 0..=1.",
                  "type": "number",
                  "format": "float"
                },
                "vehicle": {
                  "description": "Vehicle.",
                  "$ref": "#/$defs/EntityId"
                }
              },
              "required": [
                "vehicle",
                "component",
                "health"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ComponentDamaged"
          ]
        },
        {
          "description": "A component failed (crossed its failure intrusion).",
          "type": "object",
          "properties": {
            "ComponentFailed": {
              "type": "object",
              "properties": {
                "component": {
                  "description": "Component.",
                  "$ref": "#/$defs/Component"
                },
                "vehicle": {
                  "description": "Vehicle.",
                  "$ref": "#/$defs/EntityId"
                }
              },
              "required": [
                "vehicle",
                "component"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ComponentFailed"
          ]
        },
        {
          "description": "A wheel came off.",
          "type": "object",
          "properties": {
            "WheelDetached": {
              "type": "object",
              "properties": {
                "vehicle": {
                  "description": "Vehicle.",
                  "$ref": "#/$defs/EntityId"
                },
                "wheel": {
                  "description": "Wheel index (0 FL, 1 FR, 2 RL, 3 RR).",
                  "type": "integer",
                  "format": "uint8",
                  "maximum": 255,
                  "minimum": 0
                }
              },
              "required": [
                "vehicle",
                "wheel"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "WheelDetached"
          ]
        },
        {
          "description": "The vehicle is a total loss.",
          "type": "object",
          "properties": {
            "TotalLoss": {
              "type": "object",
              "properties": {
                "vehicle": {
                  "description": "Vehicle.",
                  "$ref": "#/$defs/EntityId"
                }
              },
              "required": [
                "vehicle"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "TotalLoss"
          ]
        },
        {
          "description": "A traffic violation was detected.",
          "type": "object",
          "properties": {
            "TrafficViolation": {
              "type": "object",
              "properties": {
                "kind": {
                  "description": "What happened.",
                  "$ref": "#/$defs/ViolationKind"
                },
                "vehicle": {
                  "description": "Offending vehicle.",
                  "$ref": "#/$defs/EntityId"
                }
              },
              "required": [
                "vehicle",
                "kind"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "TrafficViolation"
          ]
        },
        {
          "description": "Police event with a payload defined by `wp_police` (opaque to everyone else).",
          "type": "object",
          "properties": {
            "PoliceEvent": {
              "type": "object",
              "properties": {
                "kind": {
                  "description": "Payload kind discriminator, defined by `wp_police`.",
                  "type": "integer",
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0
                },
                "payload": {
                  "description": "Encoded payload, defined by `wp_police`.",
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "uint8",
                    "maximum": 255,
                    "minimum": 0
                  }
                }
              },
              "required": [
                "kind",
                "payload"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "PoliceEvent"
          ]
        },
        {
          "description": "Economy event with a payload defined by `wp_economy` (opaque to everyone else).",
          "type": "object",
          "properties": {
            "EconomyEvent": {
              "type": "object",
              "properties": {
                "kind": {
                  "description": "Payload kind discriminator, defined by `wp_economy`.",
                  "type": "integer",
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0
                },
                "payload": {
                  "description": "Encoded payload, defined by `wp_economy`.",
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "uint8",
                    "maximum": 255,
                    "minimum": 0
                  }
                }
              },
              "required": [
                "kind",
                "payload"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "EconomyEvent"
          ]
        }
      ]
    },
    "SurfaceType": {
      "description": "Road/ground surface classification returned by [`crate::WorldQuery::surface_at`].",
      "oneOf": [
        {
          "description": "Dry asphalt (reference surface, multiplier 1.0).",
          "type": "string",
          "const": "Asphalt"
        },
        {
          "description": "Wet asphalt.",
          "type": "string",
          "const": "WetAsphalt"
        },
        {
          "description": "Concrete.",
          "type": "string",
          "const": "Concrete"
        },
        {
          "description": "Loose gravel.",
          "type": "string",
          "const": "Gravel"
        },
        {
          "description": "Grass.",
          "type": "string",
          "const": "Grass"
        },
        {
          "description": "Packed dirt.",
          "type": "string",
          "const": "Dirt"
        },
        {
          "description": "Kerb / curb.",
          "type": "string",
          "const": "Curb"
        },
        {
          "description": "Metal plates, rails, bridge joints.",
          "type": "string",
          "const": "Metal"
        }
      ]
    },
    "VehicleState": {
      "description": "Snapshot of a vehicle's dynamic state. World space unless noted.",
      "type": "object",
      "properties": {
        "ang_vel": {
          "description": "Angular velocity in world space, rad/s.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "component_health": {
          "description": "Per-component health 0..=1. Components absent from the map are at 1.0.",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "float"
          }
        },
        "engine_rpm": {
          "description": "Engine speed, rpm.",
          "type": "number",
          "format": "float"
        },
        "gear": {
          "description": "Current gear: -1 reverse, 0 neutral, 1.. forward.",
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "health": {
          "description": "Global vehicle health, 0 (wrecked) ..= 1 (pristine).",
          "type": "number",
          "format": "float"
        },
        "lin_vel": {
          "description": "Linear velocity in world space, m/s.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "mode": {
          "description": "Damage mode in effect.",
          "$ref": "#/$defs/DamageMode"
        },
        "pos": {
          "description": "Chassis reference-point position in world space, m.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "rot": {
          "description": "Chassis orientation as a unit quaternion `[x, y, z, w]`.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 4,
          "minItems": 4
        },
        "speed_mps": {
          "description": "Forward speed (signed, along chassis +Y), m/s.",
          "type": "number",
          "format": "float"
        },
        "wheel_states": {
          "description": "Wheels, ordered FL, FR, RL, RR.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/WheelState"
          },
          "maxItems": 4,
          "minItems": 4
        }
      },
      "required": [
        "pos",
        "rot",
        "lin_vel",
        "ang_vel",
        "wheel_states",
        "engine_rpm",
        "gear",
        "speed_mps",
        "health",
        "component_health",
        "mode"
      ]
    },
    "ViolationKind": {
      "description": "Kind of traffic violation detected by `wp_world`.",
      "oneOf": [
        {
          "description": "Exceeding the speed limit.",
          "type": "object",
          "properties": {
            "Speeding": {
              "type": "object",
              "properties": {
                "over_mps": {
                  "description": "Amount over the limit, m/s.",
                  "type": "number",
                  "format": "float"
                }
              },
              "required": [
                "over_mps"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Speeding"
          ]
        },
        {
          "description": "Crossing a stop line on red.",
          "type": "string",
          "const": "RedLight"
        },
        {
          "description": "Driving against lane direction.",
          "type": "string",
          "const": "WrongWay"
        },
        {
          "description": "Collision with another road user or property.",
          "type": "string",
          "const": "Collision"
        },
        {
          "description": "Near-misses / dangerous driving.",
          "type": "string",
          "const": "Reckless"
        }
      ]
    },
    "WheelState": {
      "description": "Per-wheel runtime state.",
      "type": "object",
      "properties": {
        "compression_m": {
          "description": "Suspension compression from full droop, m.",
          "type": "number",
          "format": "float"
        },
        "contact": {
          "description": "Whether the tire touches the ground.",
          "type": "boolean"
        },
        "detached": {
          "description": "Whether the wheel has been torn off.",
          "type": "boolean"
        },
        "fz_n": {
          "description": "Vertical tire load, N.",
          "type": "number",
          "format": "float"
        },
        "omega": {
          "description": "Wheel angular velocity about its axle, rad/s (positive = rolling forward).",
          "type": "number",
          "format": "float"
        },
        "slip_angle": {
          "description": "Tire slip angle, rad.",
          "type": "number",
          "format": "float"
        },
        "slip_ratio": {
          "description": "Tire longitudinal slip ratio, dimensionless.",
          "type": "number",
          "format": "float"
        },
        "steer_rad": {
          "description": "Current road-wheel steer angle, rad (positive = left, right-handed about +Z).",
          "type": "number",
          "format": "float"
        },
        "surface": {
          "description": "Surface under the contact patch.",
          "$ref": "#/$defs/SurfaceType"
        }
      },
      "required": [
        "omega",
        "steer_rad",
        "compression_m",
        "slip_angle",
        "slip_ratio",
        "fz_n",
        "surface",
        "contact",
        "detached"
      ]
    }
  }
}
