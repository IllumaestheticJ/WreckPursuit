{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DayPhase",
  "description": "Coarse phase of the day; police and traffic tables are keyed by this.",
  "oneOf": [
    {
      "description": "05:00–07:00.",
      "type": "string",
      "const": "Dawn"
    },
    {
      "description": "07:00–18:00.",
      "type": "string",
      "const": "Day"
    },
    {
      "description": "18:00–20:00.",
      "type": "string",
      "const": "Dusk"
    },
    {
      "description": "20:00–05:00.",
      "type": "string",
      "const": "Night"
    }
  ]
}
