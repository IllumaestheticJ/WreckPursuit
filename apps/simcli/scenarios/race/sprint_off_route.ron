// wp_race: 500 m straight sprint, two coupes on the staggered grid (pole at x = -2.5, y = 0;
// second at x = 2.5, y = -4; start line y = 3). Green at 3.0 s. The second car swings ~20 m
// right of the route from 6 s, spends over 3 s more than 10 m off it, and rejoins before the
// 250 m gate: leaving the route is never a DQ, so wp_race must let it finish behind the pole.
// crates/wp_race/tests/simcli_races.rs judges this run.
// Open-loop steering, re-timed after the round-12 merge (stronger steering response): the
// last right step's end (12.2 s) sets the heading it rejoins with; ±0.2 s sends it off the route.
(
    name: "race_sprint_off_route",
    seed: 15,
    mode: Arcade,
    assists: ai,
    systems: "vehicle,damage",
    entities: [
        (
            id: "pole",
            car: "debug_coupe",
            pos: (-2.5, 0.0, 0.0),
            inputs: [(t_s: 3.2, input: (throttle: 1.0))],
        ),
        (
            id: "cutter",
            car: "debug_coupe",
            pos: (2.5, -4.0, 0.0),
            inputs: [
                (t_s: 3.2, input: (throttle: 1.0)),
                (t_s: 6.0, input: (throttle: 1.0, steer: 0.045)),
                (t_s: 7.8, input: (throttle: 1.0, steer: -0.045)),
                (t_s: 10.8, input: (throttle: 1.0, steer: 0.045)),
                (t_s: 12.2, input: (throttle: 1.0)),
            ],
        ),
    ],
    duration_s: 24.0,
    hash_every: 240,
    expect: [
        metric(name: "distance_m", entity: "pole", min: 500.0, max: 1000.0),
        metric(name: "final_health", entity: "pole", min: 1.0, max: 1.0),
    ],
)
