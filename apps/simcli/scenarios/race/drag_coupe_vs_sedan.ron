// wp_race: 402 m drag, RWD coupe vs FWD sedan side by side on the drag grid (lanes at x = ±2.5,
// 3 m behind the line at y = 3). Green is at 3.0 s (wp_race countdown); the coupe launches with a
// 0.20 s reaction, the sedan 0.35 s. crates/wp_race/tests/simcli_races.rs judges this run.
(
    name: "race_drag_coupe_vs_sedan",
    seed: 15,
    mode: Simulation,
    assists: ai,
    systems: "vehicle,damage",
    entities: [
        (
            id: "coupe",
            car: "debug_coupe",
            pos: (-2.5, 0.0, 0.0),
            inputs: [(t_s: 3.2, input: (throttle: 1.0))],
        ),
        (
            id: "sedan",
            car: "debug_sedan",
            pos: (2.5, 0.0, 0.0),
            // The FWD sedan pulls right under full power; the driver dabs left twice to hold the lane.
            inputs: [
                (t_s: 3.35, input: (throttle: 1.0)),
                (t_s: 6.0, input: (throttle: 1.0, steer: -0.006)),
                (t_s: 7.0, input: (throttle: 1.0)),
                (t_s: 11.0, input: (throttle: 1.0, steer: -0.005)),
                (t_s: 12.0, input: (throttle: 1.0)),
            ],
        ),
    ],
    duration_s: 24.0,
    hash_every: 240,
    expect: [
        metric(name: "distance_m", entity: "coupe", min: 402.0, max: 900.0),
        metric(name: "distance_m", entity: "sedan", min: 300.0, max: 800.0),
        metric(name: "max_lateral_g", entity: "coupe", min: 0.0, max: 0.1),
        metric(name: "final_health", entity: "sedan", min: 1.0, max: 1.0),
    ],
)
