// Panels (workstream R, lead feedback round 12b "the hood doesn't crumple enough"): a sedan
// hits a full-width rigid barrier at 50 km/h in Arcade. Browser: the hood buckles along two
// fold lines, tents at the centre and its leading edge follows the crushed front
// (tools/assets/panels_shots.mjs, before/after shots in docs/media/panels/).
(
    name: "panels_frontal_50_barrier_arcade",
    seed: 2150,
    mode: Arcade,
    assists: ai,
    panels: true,
    barriers: [(pos: (0.0, 8.0, 0.75), size: (6.0, 1.0, 1.5))],
    entities: [
        (id: "car", car: "debug_sedan", speed_mps: 13.89, driver: cruise(target_mps: 13.89, until_s: 0.9)),
    ],
    duration_s: 3.0,
    hash_every: 24,
    expect: [
        metric(entity: "car", name: "panels_unlatched", min: 1, max: 8),
        crush_depth(entity: "car", min: 0.1, max: 1.0),
    ],
)
