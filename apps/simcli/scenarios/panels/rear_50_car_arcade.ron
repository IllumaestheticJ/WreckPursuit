// Panels (workstream R): a parked sedan is rear-ended by a sedan at 50 km/h in Arcade. Browser:
// the rear quarters buckle outward and their tail edges follow the crushed rear bumper/frame,
// the trunk lid folds (tools/assets/panels_shots.mjs, docs/media/panels/crumple_*_rear_50_car_*).
(
    name: "panels_rear_50_car_arcade",
    seed: 2152,
    mode: Arcade,
    assists: ai,
    panels: true,
    entities: [
        (id: "car", car: "debug_sedan"),
        (id: "striker", car: "debug_sedan", pos: (0.0, -12.0, 0.0), speed_mps: 13.89, driver: cruise(target_mps: 13.89, until_s: 0.9)),
    ],
    duration_s: 3.0,
    hash_every: 24,
    expect: [
        crush_depth(entity: "car", min: 0.05, max: 1.0),
        total_loss(entity: "car", expected: false),
    ],
)
