// Owner playtest row 85 on Port Vesper v2: the same ten-minute L4 → L5 pursuit as
// `jam_pursuit_grid`, from the Lantern Run grid through downtown (Lantern Row) and Mercer to the
// Founders Cut lay-by, at noon with the city's AI police on. Same jam gates: nobody stands still
// for more than 45 s except at a red light, no queue of stopped cars longer than 12.
(
    name: "jam_pursuit_vesper",
    seed: 85,
    city: preset(name: "vesper_v2", seed: 1),
    time_of_day_h: 12.0,
    time_ratio: 1.0,
    mode: Arcade,
    police_presence: 1.0,
    assists: ai,
    slow: true,
    entities: [
        (
            id: "racer",
            car: "debug_coupe",
            police_heat: 70.0,
            speed_mps: 15.0,
            driver: follow_route(route_id: "Lantern Run -> Founders Cut lay-by", target_speed: 20.0),
        ),
    ],
    duration_s: 600.0,
    hash_every: 2400,
    expect: [
        pursuit_started_before(t_s: 60.0),
    ],
    // Work in progress (row 85): the gates the lead asked for. Measured per seed in
    // docs/integration/world.md (round 13, row 85).
    expect_pending: [
        world_metric(name: "traffic_max_stop_s", min: 0.0, max: 45.0),
        world_metric(name: "traffic_max_queue", min: 0.0, max: 12.0),
    ],
)
