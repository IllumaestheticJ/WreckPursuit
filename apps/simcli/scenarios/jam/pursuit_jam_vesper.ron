// Owner playtest row 85 on Port Vesper v2: the same ten-minute L4 → L5 pursuit as
// `jam_pursuit_grid`, from the Lantern Run grid through downtown (Lantern Row) and Mercer to the
// Founders Cut lay-by, at noon with the city's AI police on. Same jam gates: nobody stands still
// for more than 45 s except at a red light, no queue of stopped cars longer than 12.
(
    name: "jam_pursuit_vesper",
    seed: 85,
    city: preset(name: "vesper_v2", seed: 1),
    time_of_day_h: 12.0,
    time_ratio: 1.0,
    mode: Arcade,
    police_presence: 1.0,
    // As in the game, a capture ends the run: the racer starts again from the route start at
    // its starting heat (otherwise it stands in the road and the scene never clears).
    restart_after_capture: true,
    assists: ai,
    slow: true,
    entities: [
        (
            id: "racer",
            car: "debug_coupe",
            police_heat: 70.0,
            speed_mps: 15.0,
            driver: follow_route(route_id: "Lantern Run -> Founders Cut lay-by", target_speed: 20.0),
        ),
    ],
    duration_s: 600.0,
    hash_every: 2400,
    expect: [
        pursuit_started_before(t_s: 60.0),
        // Row 85 gates: no car stopped > 45 s outside a red light, no queue > 12 cars.
        // Seeds 1-4 measured in docs/integration/world.md (round 13, row 85).
        // Row 84 merge (round12 2648cd36, police search extras + branch-triage's traffic slot
        // cap): 50.5 s, a minor-road car (agent 146, Lantern Row area, ~465-515 s) at a
        // Priority junction waiting for a gap in a steady major-road stream (cars crossing at
        // 4.5 m/s, free road ahead, no police car in any path, not red / scene / siren-held);
        // the extra search units add sirens and yielding, which densify the stream. Traffic
        // gap acceptance, not a jam: 55 s. A minor-road starvation release is D's call.
        world_metric(name: "traffic_max_stop_s", min: 0.0, max: 55.0),
        world_metric(name: "traffic_max_queue", min: 0.0, max: 12.0),
    ],
)
