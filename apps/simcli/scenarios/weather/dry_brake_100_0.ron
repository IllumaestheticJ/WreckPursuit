// Control for weather/wet_brake_100_0.ron.pending: identical car, inputs and timing on a dry
// road. Owned by workstream 14 (weather). Rig measurement (wp_weather tests/vehicle_grip.rs):
// 100→0 in ~3.1 s / ~43 m dry, ~3.9 s / ~54 m soaked.
(
    name: "weather_dry_brake_100_0",
    seed: 1,
    assists: ai,
    entities: [(id: "car", car: "debug_sedan", driver: cruise(target_mps: 27.8, until_s: 14.0),
                inputs: [(t_s: 14.0, input: (brake: 1.0)), (t_s: 18.0, input: ())])],
    duration_s: 20.0,
    expect: [
        speed_at(t_s: 13.9, min: 27.0, max: 28.6),
        // Dry: stopped ~3.1 s after the pedal (measured 0.1 m/s at 17.1 s). The wet twin is still at 3–12 m/s here.
        speed_at(t_s: 17.2, min: -0.5, max: 1.0),
    ],
)
