// Clear twin of weather/fog_pursuit.ron: the golden city chase layout at noon (day sight:
// line of sight 260 m, recognition 250 m in 0.3 s). A known speeder (heat 15 = L1) drives
// north up the x = 55 collector toward the patrols; in clear air a unit recognises it from
// far away. `apps/simcli/tests/scenarios.rs::fog_delays_the_pursuit` checks that the fog twin
// starts its pursuit later than this file does.
(
    name: "weather_fog_pursuit_clear",
    seed: 111,
    city: procedural(seed: 1, blocks_x: 12, blocks_y: 12, block_m: 110.0),
    time_of_day_h: 12.0,
    time_ratio: 1.0,
    mode: Simulation,
    parked_cars: false,
    assists: keyboard,
    weather: (kind: Clear, intensity: 0.3),
    entities: [
        (
            id: "racer",
            car: "debug_coupe",
            pos: (59.75, -175.0, 0.0),
            speed_mps: 16.5,
            police_heat: 15.0,
            driver: cruise(target_mps: 16.5),
        ),
    ],
    duration_s: 20.0,
    hash_every: 24,
    expect: [
        speed_at(entity: "racer", t_s: 2.0, min: 15.0, max: 18.0),
        // Measured 2026-10-19: first pursuit at 0.30 s (fog twin: 1.90 s).
        // Re-aimed 2026-10-23 (wp_police row 158): the racer is wanted from the start, so no
        // session-start patrol may be placed in its view (it was recognised at 0.30 s by one
        // placed in plain sight). Measured 7.00 s (fog twin: 11.70 s).
        // Re-aimed 2026-10-23 (owner: Core day patrols 8 -> 3): measured 10.70 s (fog twin
        // unchanged at 11.70 s, still later).
        // Re-aimed 2026-10-29 (bridge sightlines: the grid's viaduct deck now hides what is
        // under it, so on seed 108 the clear twin was recognised at 11.90 s, after the fog twin's
        // 11.50 s). Both twins moved to seed 111: measured 4.40 s (fog twin 11.50 s).
        pursuit_started_before(t_s: 8.0),
    ],
)
