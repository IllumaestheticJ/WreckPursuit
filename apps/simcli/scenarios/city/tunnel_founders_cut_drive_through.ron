// Port Vesper v2: northbound through Founders Cut on the Uptown Connector at its 40 mph
// limit. Since the highway port the cut runs from y 893 to y 1098 (205 m covered, round 12:
// 250 m from y 1005) and its south portal is 18 m past the Connector's first junction, so the
// "Founders Cut entry" slot is 90 m before the portal along the lanes: on the Mercer block
// south of that junction (a 25 mph street; the car is over its limit there), down ≈ 4 m at up
// to 10 % and straight through the junction, then ≈ 1.3 m more at up to 7 % into the trench
// (floor ≈ 14.5 m); "Founders Cut exit" is 100 m past the north portal, ≈ 8 m up the north
// ramp at 8 %. Expect: no contact with the walls or deck, no airborne time over the sag and
// crest at the ramps, the car stays on the road and arrives undamaged.
//
// path_length_m: the route is 90 m + 205 m + 100 m along the lanes plus the ≈ 23 m connector
// through the junction = 419 m (round 12: 91 + 250 + 99 m on one road = 440 m, range
// [380, 500]); the range keeps round 12's ± 60 m round it: [360, 480].
(
    name: "city_tunnel_founders_cut_drive_through",
    seed: 42,
    city: preset(name: "vesper_v2", seed: 1),
    time_of_day_h: 23.0,
    time_ratio: 1.0,
    traffic_density: 0.0,
    parked_cars: false,
    police_cars: false,
    assists: ai,
    slow: true,
    entities: [
        (
            id: "car",
            car: "debug_sedan",
            driver: follow_route(route_id: "Founders Cut entry -> Founders Cut exit", target_speed: 17.88),
        ),
    ],
    duration_s: 40.0,
    expect: [
        metric(name: "route_progress", min: 0.97, max: 1.0),
        metric(name: "off_road_s", min: 0.0, max: 0.5),
        metric(name: "max_airborne_s", min: 0.0, max: 0.05),
        metric(name: "max_speed_mps", min: 15.0, max: 19.0),
        metric(name: "crush_depth_m", min: 0.0, max: 0.02),
        metric(name: "path_length_m", min: 360.0, max: 480.0),
        total_loss(expected: false),
    ],
)
