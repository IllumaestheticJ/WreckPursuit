// Golden "feel" case: 56 km/h (15.56 m/s) full frontal into a stationary sedan acting as a
// barrier 60 m ahead, Simulation mode. Needs vehicle rigid bodies + damage (prompts 02/03/12);
// until then the cars pass through each other and only the approach is checked.
(
    name: "golden_frontal_56kmh",
    seed: 103,
    mode: Simulation,
    assists: ai,
    entities: [
        (id: "car", car: "debug_sedan", driver: cruise(target_mps: 15.56)),
        (id: "barrier", car: "debug_sedan", pos: (0.0, 60.0, 0.0), yaw: 3.14159),
    ],
    duration_s: 8.0,
    hash_every: 24,
    expect: [
        speed_at(entity: "car", t_s: 4.0, min: 15.0, max: 16.1),
        metric(entity: "barrier", name: "distance_m", min: 0.0, max: 0.01),
    ],
    expect_pending: [
        crush_depth(entity: "car", min: 0.25, max: 0.8),
        total_loss(entity: "car", expected: true),
        components_failed(entity: "car", min: 1, max: 20),
        event_count(event: "Contact", entity: "car", min: 1, max: 100000),
    ],
)
