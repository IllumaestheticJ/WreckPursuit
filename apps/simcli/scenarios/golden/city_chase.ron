// Golden "feel" case: city chase. 23:00 in the 12×12 procedural city with physical traffic and
// police cars (wp_police on the city graph, units driven as real vehicles since lead run 5).
// A known speeder (starting heat 25 = wanted level L1, e.g. from an earlier report) does
// 16.5 m/s (59 km/h; the street's limit is 40 km/h) east along y = 273.2, behind the night's
// only patrol (owner 2026-10-23: one patrol city-wide at night), which starts near (-145, 273)
// heading east. The racer has to catch it before its heat decays below L1. The pursuit must
// start within 20 s. Re-aimed 2026-10-23 (was a start on the x = 275 street behind a patrol
// that no longer exists, heat 15): starts from x = -270 to x = -210 pursue within 20 s with
// heat 25 (none with 15: the heat decays below L1 first); x = -240 is the middle of that band.
// Re-aimed for the police PR port (2026-10-24: PR #66 put road network centrelines on the
// road centre, so the graph and the patrol's start moved): the night's only patrol now
// starts at (276.8, 131) heading north. The racer starts 130 m behind it on that street
// (276.8, 0) heading north; starts from y = -120 to y = 120 all pursue within 20 s.
// If police spawning changes, re-aim with `examples/probe_police.rs`.
(
    name: "golden_city_chase",
    seed: 108,
    city: procedural(seed: 1, blocks_x: 12, blocks_y: 12, block_m: 110.0),
    time_of_day_h: 23.0,
    time_ratio: 1.0,
    mode: Simulation,
    // Parked cars (3000+ physics bodies) don't take part in the chase and make debug test
    // runs very slow.
    parked_cars: false,
    assists: keyboard,
    entities: [
        (
            id: "racer",
            car: "debug_coupe",
            pos: (276.8, 0.0, 0.0),
            yaw: 0.0,
            speed_mps: 16.5,
            police_heat: 25.0,
            driver: cruise(target_mps: 16.5),
            inputs: [(t_s: 0.0, input: (headlights: true))],
        ),
    ],
    duration_s: 20.0,
    hash_every: 24,
    expect: [
        speed_at(entity: "racer", t_s: 2.0, min: 15.0, max: 18.0),
        event_count(event: "TrafficViolation", entity: "racer", min: 1, max: 100000),
        world_metric(name: "police_units_max", min: 1.0, max: 100.0),
        pursuit_started_before(t_s: 20.0),
        metric(entity: "racer", name: "final_health", min: 0.8, max: 1.0),
    ],
)
