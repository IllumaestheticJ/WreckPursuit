// Golden "feel" case: city chase. 23:00 in the 12×12 procedural city with physical traffic and
// police cars (wp_police on the city graph, units driven as real vehicles since lead run 5).
// A known speeder (starting heat 15 = wanted level L1, e.g. from an earlier report) does
// 16.5 m/s (59 km/h; the collector's limit is 48 km/h) north up the outer lane of the x = 55
// collector, past the patrol that starts near (55, -21). At night a pursuit needs a unit to
// keep the racer within 40 m for 4 s, so the pass is slow and clear of the patrol car.
// The pursuit must start within 20 s (it starts at about 6 s; every lane/speed/start nearby
// gives 5-9 s). If police spawning changes, re-aim with `examples/probe_police.rs`.
(
    name: "golden_city_chase",
    seed: 108,
    city: procedural(seed: 1, blocks_x: 12, blocks_y: 12, block_m: 110.0),
    time_of_day_h: 23.0,
    time_ratio: 1.0,
    mode: Arcade,
    // Parked cars (3000+ physics bodies) don't take part in the chase and make debug test
    // runs very slow.
    parked_cars: false,
    assists: keyboard,
    entities: [
        (
            id: "racer",
            car: "debug_coupe",
            pos: (59.75, -100.0, 0.0),
            speed_mps: 16.5,
            police_heat: 15.0,
            driver: cruise(target_mps: 16.5),
            inputs: [(t_s: 0.0, input: (headlights: true))],
        ),
    ],
    duration_s: 20.0,
    hash_every: 24,
    expect: [
        speed_at(entity: "racer", t_s: 2.0, min: 15.0, max: 18.0),
        event_count(event: "TrafficViolation", entity: "racer", min: 1, max: 100000),
        world_metric(name: "police_units_max", min: 1.0, max: 100.0),
        pursuit_started_before(t_s: 20.0),
        metric(entity: "racer", name: "final_health", min: 0.8, max: 1.0),
    ],
)
