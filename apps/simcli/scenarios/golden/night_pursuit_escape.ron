// Golden "feel" case: night pursuit escape. 23:00 in the procedural city, a racer speeds past a
// patrol car parked at the kerb which starts a pursuit; the racer (northbound lane of the x = 60
// collector) kills its lights and must break line of sight and escape (prompts
// 05/06). The city and traffic are real (procedural 8×8); police is still pending.
(
    name: "golden_night_pursuit_escape",
    // Traffic seed: with 106 a civilian sat in the racer's lane after the highway viaduct
    // changed the network (the cruise driver does not steer around traffic).
    seed: 107,
    city: procedural(seed: 7, blocks_x: 8, blocks_y: 8, block_m: 120.0),
    time_of_day_h: 23.0,
    mode: Arcade,
    assists: keyboard,
    police_presence: 1.0,
    traffic_density: 0.3,
    entities: [
        (
            id: "racer",
            pos: (61.5, -400.0, 0.0),
            car: "debug_coupe",
            speed_mps: 35.0,
            driver: cruise(target_mps: 35.0),
            inputs: [(t_s: 0.0, input: (headlights: true)), (t_s: 6.0, input: (headlights: false))],
        ),
        (id: "patrol", car: "debug_sedan", pos: (70.0, -200.0, 0.0), inputs: [(t_s: 0.0, input: (headlights: true))]),
    ],
    duration_s: 12.0,
    hash_every: 24,
    expect: [
        speed_at(entity: "racer", t_s: 5.5, min: 30.0, max: 40.0),
        // Stays in its lane: no crash into parked cars or traffic.
        metric(entity: "racer", name: "final_health", min: 0.8, max: 1.0),
    ],
    expect_pending: [
        pursuit_started_before(t_s: 6.0),
        // wp_police::events::kind::PURSUIT_ENDED (escape).
        police_event_before(kind: 4, t_s: 12.0),
    ],
)
