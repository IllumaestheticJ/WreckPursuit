// Golden "feel" case: 56 km/h (15.56 m/s) full frontal into a rigid wall (static box),
// Simulation mode, the classic barrier test. The car starts at speed 15 m before the wall and
// coasts into it. Per CLAUDE.md, Simulation mode treats one hard hit at speed as a total loss.
(
    name: "golden_barrier_56kmh",
    seed: 107,
    mode: Extreme,
    assists: ai,
    barriers: [(pos: (0.0, 20.0, 0.75), size: (8.0, 1.0, 1.5))],
    entities: [
        (id: "car", car: "debug_sedan", speed_mps: 15.56, driver: cruise(target_mps: 15.56, until_s: 0.6)),
    ],
    duration_s: 3.0,
    hash_every: 24,
    expect: [
        speed_at(t_s: 0.5, min: 15.0, max: 16.1),
        event_count(event: "Contact", entity: "car", min: 1, max: 100000),
        world_metric(name: "static_boxes", min: 1.0, max: 1.0),
        metric(name: "max_long_g", min: 5.0, max: 200.0),
        crush_depth(min: 0.4, max: 1.2),
        components_failed(min: 1, max: 20),
        total_loss(expected: true),
    ],
)
