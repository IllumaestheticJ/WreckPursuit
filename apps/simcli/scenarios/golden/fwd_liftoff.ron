// Golden "feel" case: FWD lift-off oversteer. Sedan cruises at 25 m/s, turns in, then lifts
// completely mid-corner. With real tires (prompt 02) the rear should step out on lift-off.
(
    name: "golden_fwd_liftoff",
    seed: 101,
    mode: Simulation,
    // No aids, but an automatic gearbox so the cruise run-up can reach 25 m/s.
    assists: custom((abs: false, tcs: false, esc: false, steer_speed_sensitivity: 0.0,
        countersteer_help: 0.0, throttle_filter: 0.0, brake_filter: 0.0, auto_gears: true,
        auto_clutch: true)),
    entities: [
        (
            id: "sedan",
            car: "debug_sedan",
            speed_mps: 25.0,
            driver: cruise(target_mps: 25.0, until_s: 4.0),
            inputs: [
                (t_s: 0.0, input: ()),
                (t_s: 2.0, input: (steer: 0.35)),
                (t_s: 4.0, input: (steer: 0.35)),
                (t_s: 6.0, input: ()),
            ],
        ),
    ],
    duration_s: 8.0,
    hash_every: 24,
    expect: [
        speed_at(t_s: 1.9, min: 22.0, max: 28.0),
        metric(name: "final_health", min: 1.0, max: 1.0),
    ],
    expect_pending: [
        // Lift-off rotation: yaw rate should spike after 14 s (prompt 02).
        metric(name: "max_yaw_rate_rps", min: 0.4, max: 2.0),
        max_lateral_g(min: 0.6, max: 1.2),
    ],
)
