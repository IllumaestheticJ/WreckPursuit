// Golden "feel" case: spike strip. A racer at 30 m/s with police present; a police unit lays a
// strip ahead (prompt 06), front tires deflate and the car must stay controllable while
// slowing. Until police tools exist only the run itself is checked.
(
    name: "golden_spike_strip",
    seed: 105,
    mode: Arcade,
    assists: keyboard,
    police_presence: 1.0,
    entities: [
        (id: "racer", car: "debug_sedan", speed_mps: 30.0, driver: cruise(target_mps: 30.0, until_s: 6.0)),
        (id: "police", car: "debug_coupe", pos: (4.0, 150.0, 0.0), inputs: [(t_s: 1.0, input: (siren: true, tool_use: 1))]),
    ],
    duration_s: 9.0,
    hash_every: 24,
    expect: [
        speed_at(entity: "racer", t_s: 4.0, min: 27.0, max: 32.0),
    ],
    expect_pending: [
        // wp_police::events::kind::SPIKES_PLACED.
        police_event_before(kind: 9, t_s: 3.0),
        event_count(event: "ComponentDamaged", entity: "racer", min: 1, max: 100),
        metric(entity: "racer", name: "final_speed_mps", min: 0.0, max: 20.0),
    ],
)
