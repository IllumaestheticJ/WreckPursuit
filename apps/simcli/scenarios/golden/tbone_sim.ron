// Golden "feel" case: the golden_tbone crash in Simulation (wp_damage, machine B). A coupe at
// 50 km/h (13.9 m/s) along +X hits the driver side of a sedan crossing along +Y at 8 m/s.
// Pins the mode pair with golden_tbone (Arcade, victim crush 0.165 m): Simulation puts ~2x the
// energy into the lattice, so the first hit crushes the door/B-pillar ~0.32 m (cabin 0.31 m >
// Sim's 0.25 m limit -> TotalLoss) and the striker, still on the throttle, adds more after.
// crush_depth is structural crush (`DamageModel::structural_crush_m`, no glass or bumper
// covers): victim 0.35 m, striker 0.19 m (round 8; the old any-node max read 0.35 / 0.42).
(
    name: "golden_tbone_sim",
    seed: 104,
    mode: Simulation,
    assists: ai,
    entities: [
        (id: "victim", car: "debug_sedan", pos: (0.0, -16.0, 0.0), speed_mps: 8.0, driver: cruise(target_mps: 8.0)),
        (id: "striker", car: "debug_coupe", pos: (-28.0, 0.0, 0.0), yaw: -1.5708, speed_mps: 13.9, driver: cruise(target_mps: 13.9)),
    ],
    duration_s: 4.0,
    hash_every: 24,
    expect: [
        speed_at(entity: "striker", t_s: 1.0, min: 12.0, max: 15.0),
        speed_at(entity: "victim", t_s: 1.0, min: 7.0, max: 9.0),
        crush_depth(entity: "victim", min: 0.25, max: 0.8),
        components_failed(entity: "victim", min: 2, max: 20),
        total_loss(entity: "victim", expected: true),
        crush_depth(entity: "striker", min: 0.1, max: 0.7),
        total_loss(entity: "striker", expected: false),
    ],
)
