// Contract v0.4.0: the pre-v0.4.0 Arcade table is now Simulation, so this scenario keeps its
// name and runs `mode: Simulation` (same behaviour and hashes as before).
// Golden "feel" case: the classic 56 km/h (15.56 m/s) full frontal into a rigid wall (static
// box) in Arcade mode — the counterpart of `barrier_56kmh` (Simulation, total loss). Arcade is
// "punishing but survivable" (CLAUDE.md): the same hit crushes and degrades the car, damages
// the front, but does not write it off; it takes several such hits to end it.
(
    name: "golden_barrier_56kmh_arcade",
    seed: 108,
    mode: Simulation,
    assists: ai,
    barriers: [(pos: (0.0, 20.0, 0.75), size: (8.0, 1.0, 1.5))],
    entities: [
        (id: "car", car: "debug_sedan", speed_mps: 15.56, driver: cruise(target_mps: 15.56, until_s: 0.6)),
    ],
    duration_s: 3.0,
    hash_every: 24,
    expect: [
        speed_at(t_s: 0.5, min: 15.0, max: 16.1),
        event_count(event: "Contact", entity: "car", min: 1, max: 100000),
        world_metric(name: "static_boxes", min: 1.0, max: 1.0),
        metric(name: "max_long_g", min: 5.0, max: 200.0),
        crush_depth(min: 0.2, max: 0.9),
        metric(name: "final_health", min: 0.5, max: 0.95),
        total_loss(expected: false),
    ],
)
