// Round 13 (owner playtest row 87: Arcade damage still a little too high), workstream 03.
// Full sim, Arcade, R's panels on as in the browser game. Measured by
// `cargo run --release -p simcli --example damage_toughness` (tables in docs/integration/damage.md).
// The weakest car (junkyard beater) into a rigid wall at 50 km/h: cosmetic plus minor mechanical.
(
    name: "damage_arcade_beater_frontal_50",
    seed: 504,
    mode: Arcade,
    assists: ai,
    panels: true,
    barriers: [(pos: (0.0, 20.0, 0.75), size: (10.0, 1.0, 1.5))],
    entities: [
        (id: "car", car: "junkyard_beater", speed_mps: 13.9, driver: cruise(target_mps: 13.9, until_s: 0.6)),
    ],
    duration_s: 3.0,
    hash_every: 60,
    expect: [
        total_loss(entity: "car", expected: false),
        metric(entity: "car", name: "final_health", min: 0.8, max: 0.97),
        components_failed(entity: "car", min: 0, max: 0),
        metric(entity: "car", name: "wheels_detached", min: 0.0, max: 0.0),
        crush_depth(entity: "car", min: 0.25, max: 1.0),
    ],
)
