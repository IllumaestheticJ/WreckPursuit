// Contract v0.4.0: the pre-v0.4.0 Arcade table is now Simulation, so this scenario keeps its
// name and runs `mode: Simulation` (same behaviour and hashes as before).
// Round 12b (owner playtest rows 48-49: Arcade cars and police too fragile), workstream 03.
// Full sim, Arcade, R's panels on as in the browser game. Repeated hits are measured by
// `cargo run --release -p simcli --example damage_toughness` (table in docs/integration/damage.md).
// A sedan side-swipes the sports car at 90 km/h, 20 degrees in: cosmetic only.
(
    name: "damage_arcade_sports_swipe_90",
    seed: 506,
    mode: Simulation,
    assists: ai,
    panels: true,
    entities: [
        (id: "car", car: "hakone_gt", speed_mps: 25.0, driver: cruise(target_mps: 25.0, until_s: 2.0)),
        (id: "striker", car: "debug_sedan", pos: (-3.3, 0.5, 0.0), yaw: -0.349, speed_mps: 25.0, driver: cruise(target_mps: 25.0, until_s: 0.4),
            inputs: [(t_s: 0.4, input: (brake: 1.0))]),
    ],
    duration_s: 3.0,
    hash_every: 60,
    expect: [
        total_loss(entity: "car", expected: false),
        metric(entity: "car", name: "final_health", min: 0.97, max: 1.0),
        components_failed(entity: "car", min: 0, max: 0),
        event_count(event: "Contact", entity: "car", min: 1, max: 100000),
    ],
)
