// Junkyard beater (economy floor car), full throttle from rest: 0-100 km/h must take
// 14-16 s (lead brief round 12b, data/cars/VALIDATION.md). Not at 100 km/h (27.78 m/s) at
// 14 s, past it by 16 s. Re-ranged (physics lead, 2026-10-23, candidate G tyres / ride, owner
// rows physics-4 / physics-5): the beater reaches 100 km/h at ~16.05 s (99.6 km/h at 16.0 s);
// checked at 16.2 s.
(
    name: "cars_beater_accel",
    mode: Simulation,
    seed: 1,
    duration_s: 16.5,
    entities: [
        (
            id: "car",
            car: "junkyard_beater",
            inputs: [(t_s: 0.0, input: (throttle: 1.0))],
        ),
    ],
    expect: [
        speed_at(entity: "car", t_s: 14.0, min: 20.0, max: 27.77),
        speed_at(entity: "car", t_s: 16.2, min: 27.78, max: 33.0),
    ],
)
