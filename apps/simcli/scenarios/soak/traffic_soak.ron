// World soak, workstream 05's acceptance numbers: the 12×12 procedural city at noon, traffic at
// 4× density (the 400-agent cap), no player cars (as in wp_world's `safety_run` test). Civilian
// traffic must stay collision-free, fully populated and flowing for a simulated minute.
(
    name: "world_traffic_soak",
    seed: 5,
    city: file("city/procedural_12x12.road.json"),
    time_of_day_h: 12.0,
    time_ratio: 1.0,
    traffic_density: 4.0,
    entities: [],
    duration_s: 60.0,
    expect: [
        world_metric(name: "civilian_collisions", min: 0.0, max: 0.0),
        world_metric(name: "traffic_agents_min", min: 380.0, max: 400.0),
        world_metric(name: "traffic_moving_frac_final", min: 0.5, max: 1.0),
        world_metric(name: "traffic_moving_frac_min", min: 0.5, max: 1.0),
    ],
)
