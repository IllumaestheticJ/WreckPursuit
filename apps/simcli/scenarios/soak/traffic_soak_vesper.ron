// World soak on Port Vesper v2 (hills, curves, highway loop, grade separations): same gates as
// `world_traffic_soak` on the grid — traffic at 4× density (the 400-agent cap), no player
// cars; civilian traffic must stay collision-free, populated and flowing for a minute.
(
    name: "world_traffic_soak_vesper",
    seed: 5,
    city: preset(name: "vesper_v2", seed: 1),
    time_of_day_h: 12.0,
    time_ratio: 1.0,
    traffic_density: 4.0,
    entities: [],
    duration_s: 60.0,
    expect: [
        world_metric(name: "civilian_collisions", min: 0.0, max: 0.0),
        world_metric(name: "traffic_agents_min", min: 380.0, max: 400.0),
        world_metric(name: "traffic_moving_frac_final", min: 0.5, max: 1.0),
        world_metric(name: "traffic_moving_frac_min", min: 0.5, max: 1.0),
    ],
)
