// World soak on Port Vesper v2 with a player car parked downtown (Lantern Row): near-player
// traffic is physical (Rapier bodies on the terrain/road colliders). Same gates as
// `world_traffic_soak_observer` on the grid.
(
    name: "world_traffic_soak_vesper_observer",
    seed: 5,
    city: preset(name: "vesper_v2", seed: 1),
    time_of_day_h: 12.0,
    time_ratio: 1.0,
    traffic_density: 4.0,
    police_cars: false,
    assists: ai,
    entities: [
        (
            id: "observer",
            car: "debug_sedan",
            pos: (-150.0, 48.25, 9.6),
            yaw: -1.5708,
            // Parked on a gentle grade: handbrake on.
            inputs: [(t_s: 0.0, input: (handbrake: 1.0))],
        ),
    ],
    duration_s: 60.0,
    expect: [
        world_metric(name: "civilian_collisions", min: 0.0, max: 3.0),
        world_metric(name: "traffic_agents_min", min: 350.0, max: 400.0),
        world_metric(name: "traffic_moving_frac_min", min: 0.5, max: 1.0),
        metric(name: "distance_m", min: 0.0, max: 0.5),
    ],
    expect_pending: [
        world_metric(name: "civilian_collisions", min: 0.0, max: 0.0),
        world_metric(name: "traffic_agents_min", min: 380.0, max: 400.0),
    ],
)
