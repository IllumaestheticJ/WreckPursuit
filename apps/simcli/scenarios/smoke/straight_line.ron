// Smoke: FWD sedan, full throttle for 6 s, full brake until 8 s, then hold the handbrake to a
// stop (holding the brake pedal at a standstill would engage auto-reverse).
(
    name: "smoke_straight_line",
    seed: 1,
    mode: Arcade,
    assists: ai,
    entities: [
        (
            id: "sedan",
            car: "debug_sedan",
            inputs: [
                (t_s: 0.0, input: (throttle: 1.0)),
                (t_s: 6.0, input: (brake: 1.0)),
                (t_s: 8.0, input: (handbrake: 1.0)),
            ],
        ),
    ],
    duration_s: 14.0,
    hash_every: 240,
    expect: [
        metric(name: "max_speed_mps", min: 15.0, max: 30.0),
        metric(name: "final_speed_mps", min: -0.2, max: 0.2),
        metric(name: "distance_m", min: 60.0, max: 150.0),
        metric(name: "final_health", min: 1.0, max: 1.0),
        speed_at(t_s: 3.0, min: 8.0, max: 40.0),
        max_lateral_g(min: 0.0, max: 0.05),
    ],
)
