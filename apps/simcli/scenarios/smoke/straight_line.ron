// Smoke test: full throttle for 6 s, full brake until 11 s, then coast to the end. Ranges are loose (kinematic stub);
// workstream 02 tightens them once real vehicle dynamics land.
(
    name: "smoke_straight_line",
    car: "debug_sedan",
    mode: Arcade,
    seed: 1,
    duration_s: 14.0,
    inputs: [
        (t_s: 0.0, input: (throttle: 1.0)),
        (t_s: 6.0, input: (brake: 1.0)),
        (t_s: 11.0, input: ()),
    ],
    expect: [
        (metric: "max_speed_mps", min: 15.0, max: 60.0),
        (metric: "final_speed_mps", min: 0.0, max: 1.0),
        (metric: "distance_m", min: 40.0, max: 500.0),
        (metric: "final_health", min: 1.0, max: 1.0),
    ],
)
