// Smoke: the procedural city with every opt-out set (no moving traffic, no parked cars, no
// police units): only the road network and the player's car. Useful as a template for
// physics tests in the city that should not be disturbed by AI cars.
(
    name: "smoke_city_opt_out",
    seed: 9,
    city: procedural(seed: 1, blocks_x: 8, blocks_y: 8, block_m: 120.0),
    time_of_day_h: 23.0,
    traffic_cars: false,
    parked_cars: false,
    police_cars: false,
    assists: ai,
    entities: [
        (id: "car", car: "debug_sedan", pos: (61.5, -300.0, 0.0), speed_mps: 20.0, driver: cruise(target_mps: 20.0)),
    ],
    duration_s: 5.0,
    expect: [
        world_metric(name: "traffic_agents_final", min: 0.0, max: 0.0),
        world_metric(name: "props", min: 0.0, max: 0.0),
        world_metric(name: "police_units_max", min: 0.0, max: 0.0),
        speed_at(t_s: 4.0, min: 19.0, max: 21.0),
        metric(name: "final_health", min: 1.0, max: 1.0),
    ],
)
