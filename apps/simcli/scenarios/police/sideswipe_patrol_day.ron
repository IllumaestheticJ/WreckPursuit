// Owner playtest row 24 ("I sideswiped a cop and a chase didn't start"), noon, 12x12 grid city,
// no traffic or parked cars. Re-aimed 2026-10-21 for main's rebuilt grid (divided viaduct at
// x = 0, ramp terminals at x = ±22): patrol unit 6 now drives east along y = -56.75 toward the
// junction at x = -55. The racer (no heat) starts at x = -20 just left of the centreline, cruises
// west at 30 km/h from 1 s and meets it at 7.6 s: a front-corner clip (11 kN·s, 13 m/s closing)
// then a flank scrape (1.7 kN·s). wp_police counts it as assaulting an officer: wanted L2 and the
// pursuit start in the same tick, with the radio line "Unit 6, I've been hit! ...". No
// violation is seen before the contact, so nothing else could start the pursuit by 8.0 s. Half a
// metre further right the unit dodges and there is no contact. Re-aim with
// `examples/probe_police.rs` if police spawning changes.
// 2026-10-23: aimed at one particular patrol unit, so it keeps the patrol counts from before the
// owner's cut (`dense_patrols`); it checks the assault rule, not how many cops patrol.
(
    name: "police_sideswipe_patrol_day",
    seed: 24,
    city: procedural(seed: 1, blocks_x: 12, blocks_y: 12, block_m: 110.0),
    time_of_day_h: 12.0,
    time_ratio: 1.0,
    mode: Simulation,
    parked_cars: false,
    traffic_density: 0.0,
    dense_patrols: true,
    assists: keyboard,
    entities: [
        (
            id: "racer",
            car: "debug_sedan",
            pos: (-20.0, -55.2, 0.0),
            yaw: 1.5708,
            driver: cruise(target_mps: 8.33, from_s: 1.0),
            inputs: [],
        ),
    ],
    duration_s: 10.0,
    hash_every: 24,
    expect: [
        speed_at(entity: "racer", t_s: 5.5, min: 7.5, max: 9.0),
        event_count(event: "Contact", entity: "racer", min: 1, max: 20),
        // Wanted-level change and pursuit within 0.4 s of the 7.6 s contact.
        police_event_before(kind: 2, t_s: 8.0),
        pursuit_started_before(t_s: 8.0),
        metric(entity: "racer", name: "final_health", min: 0.8, max: 1.0),
    ],
)
