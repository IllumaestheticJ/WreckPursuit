// Backlog B04: a tunnel breaks the helicopter's line of sight. Midday in Port Vesper v2, a
// racer already at wanted level L3 (heat 50) follows the route from the Lantern Run grid
// through downtown and Mercer, up the Uptown Connector and into Founders Cut (the 250 m covered
// trench), and stops at the "Founders Cut lay-by" in the middle of it. A downtown patrol starts
// the pursuit within seconds, the helicopter launches at ≈ 58 s and sits over the racer from
// ≈ 68 s. Inside the Cut nothing outside can see in: the helicopter loses him as he enters
// (≈ 100 s) and he stays unseen for ≈ 19 s.
//
// Since the round-12b police doctrine (owner playtest rows 61-64: up to 8 units per racer, a
// 1.1 km backup radius at L4, 4-10 s day response, units driving to the racer's predicted
// position) the backup reaches the Cut before the L4 escape time (30 s) runs out and finds
// him inside the same tunnel, so the pursuit ends in a capture, not an escape. The tunnel
// still holds him longer than the control run (tunnel_escape_founders_cut_control.ron,
// `covered_los: false`, where the helicopter never loses him). Measured (heat 50, racer
// target 22 / 25 / 28 m/s): unseen 11.0 / 19.1 / 18.8 s and captured at 130.3 / 133.8 /
// 127.1 s here; the control is unseen 0.0 / 0.1 / 3.8 s and captured at 129.4 / 126.7 /
// 124.3 s. (Heat 30-45 is caught or lost downtown before the tunnel matters.) Re-aim with
// `examples/probe_tunnel_chase.rs`. The round-12a version of this scenario was a clean
// escape (122 s) vs capture (157 s); see docs/integration/tunnels.md.
(
    name: "police_tunnel_escape_founders_cut",
    seed: 51,
    city: preset(name: "vesper_v2", seed: 1),
    time_of_day_h: 12.0,
    time_ratio: 1.0,
    mode: Arcade,
    traffic_density: 0.0,
    parked_cars: false,
    police_presence: 1.0,
    assists: ai,
    slow: true,
    entities: [
        (
            id: "racer",
            car: "debug_coupe",
            police_heat: 50.0,
            speed_mps: 20.0,
            driver: follow_route(route_id: "Lantern Run -> Founders Cut lay-by", target_speed: 25.0),
        ),
    ],
    duration_s: 170.0,
    hash_every: 240,
    expect: [
        pursuit_started_before(t_s: 15.0),
        // wp_police HeloLaunched (kind 12).
        police_event_before(kind: 12, t_s: 80.0),
        metric(entity: "racer", name: "route_progress", min: 0.97, max: 1.0),
        // The tunnel hides him from the helicopter for well over the downtown gaps.
        metric(entity: "racer", name: "max_los_lost_s", min: 9.0, max: 60.0),
        // Held until the backup finds him in the tunnel (the control is captured sooner).
        first_pursuit_end(entity: "racer", outcome: "Captured", min_s: 125.0, max_s: 170.0),
        total_loss(entity: "racer", expected: false),
    ],
)
