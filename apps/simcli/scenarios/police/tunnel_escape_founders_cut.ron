// Backlog B04: shaking the helicopter in a tunnel. Midday in Port Vesper v2, a racer already at
// wanted level L3 (heat 55) drives from the Lantern Run grid through downtown and Mercer, up
// the Uptown Connector and into Founders Cut (the 250 m covered trench), and stops at the
// "Founders Cut lay-by" in the middle of it. A downtown patrol starts the pursuit within
// seconds; the helicopter launches at ≈ 50 s and sits over the racer from ≈ 56 s (the ground
// units fall 300+ m behind). Inside the Cut nothing outside can see in: the helicopter loses
// the racer at ≈ 97 s and the L4 day escape time (30 s) runs out at ≈ 127 s → Escaped, while
// the nearest unit is still ≈ 180 m out. (A unit that drives into the Cut afterwards sees him
// inside and starts a new pursuit; the run ends before that matters.)
//
// The same run with `covered_los: false` (tunnel_escape_founders_cut_control.ron) is captured
// instead: the helicopter keeps watching the parked car until ground units arrive.
// Measured (lead tunnels round, racer target 22 / 24 / 25 / 27 m/s): escape at 134.2 / 128.9 /
// 126.9 / 123.5 s here; the control's first pursuit end is a capture at 167.7 / 149.5 /
// 142.0 / 141.2 s every time. Re-aim with `examples/probe_tunnel_chase.rs`.
(
    name: "police_tunnel_escape_founders_cut",
    seed: 51,
    city: preset(name: "vesper_v2", seed: 1),
    time_of_day_h: 12.0,
    time_ratio: 1.0,
    mode: Arcade,
    traffic_density: 0.0,
    parked_cars: false,
    police_presence: 1.0,
    assists: ai,
    slow: true,
    entities: [
        (
            id: "racer",
            car: "debug_coupe",
            police_heat: 55.0,
            speed_mps: 20.0,
            driver: follow_route(route_id: "Lantern Run -> Founders Cut lay-by", target_speed: 25.0),
        ),
    ],
    duration_s: 140.0,
    hash_every: 240,
    expect: [
        pursuit_started_before(t_s: 15.0),
        // wp_police HeloLaunched (kind 12).
        police_event_before(kind: 12, t_s: 60.0),
        metric(entity: "racer", name: "route_progress", min: 0.97, max: 1.0),
        first_pursuit_end(entity: "racer", outcome: "Escaped", min_s: 110.0, max_s: 140.0),
        total_loss(entity: "racer", expected: false),
    ],
)
