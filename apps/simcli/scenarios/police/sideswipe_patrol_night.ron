// Owner playtest row 24 at night: 23:00, 12x12 grid city, no traffic or parked cars. Patrol
// unit 3 spawns at (-166.8, -300.8) and drives south down x = -166.75 at about 11 m/s. The racer
// (no heat) starts parked in its own northbound lane just north of the junction at y = -385,
// cruises north at 30 km/h from 1 s and steers left (-0.5) at 4.8 s for 0.8 s: a side-to-side
// swipe with the oncoming cruiser at 5.45 s (about 2,500 N·s, contact normal sideways). The
// steer is centred in a window that swipes (4.7-4.95 s at -0.5; earlier is a head-on crash,
// later a miss). At night a pursuit otherwise needs a wanted racer within 40 m for 4 s; the
// hit unit recognises the racer at once instead, so wanted L2 and the pursuit start in the
// contact's tick. Without the fix this run has no police event for the racer at all.
// Re-aimed 2026-10-21: after the highway port (grid viaduct, new lanes) the patrols spawn
// elsewhere and the old target (unit 3 driving south down x = -276.8 at 11-12 s) is gone.
// Re-aim with `examples/probe_police.rs` if police spawning changes.
(
    name: "police_sideswipe_patrol_night",
    seed: 24,
    city: procedural(seed: 1, blocks_x: 12, blocks_y: 12, block_m: 110.0),
    time_of_day_h: 23.0,
    time_ratio: 1.0,
    mode: Arcade,
    parked_cars: false,
    traffic_density: 0.0,
    assists: keyboard,
    entities: [
        (
            id: "racer",
            car: "debug_sedan",
            pos: (-163.25, -372.0, 0.0),
            driver: cruise(target_mps: 8.33, from_s: 1.0),
            inputs: [
                (t_s: 4.8, input: (steer: -0.5)),
                (t_s: 5.6, input: ()),
            ],
        ),
    ],
    duration_s: 10.0,
    hash_every: 24,
    expect: [
        speed_at(entity: "racer", t_s: 4.5, min: 7.5, max: 9.0),
        event_count(event: "Contact", entity: "racer", min: 1, max: 40),
        // Wanted-level change and pursuit within 0.55 s of the 5.45 s contact.
        police_event_before(kind: 2, t_s: 6.0),
        pursuit_started_before(t_s: 6.0),
    ],
)
