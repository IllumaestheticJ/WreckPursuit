// Contract v0.4.0: the pre-v0.4.0 Simulation table is now Extreme, so this scenario keeps its
// name and runs `mode: Extreme` (same behaviour and hashes as before).
// Testbed crash test (workstream 04): debug sedan holds 56 km/h into a rigid barrier, Simulation.
// The testbed's speed box overrides `target_mps`. Simulation: one hard hit at speed is a total loss.
(
    name: "crash_barrier_frontal_sim",
    seed: 11,
    mode: Extreme,
    assists: ai,
    barriers: [(pos: (0.0, 45.0, 0.75), size: (8.0, 1.0, 1.5))],
    entities: [
        (id: "car", car: "debug_sedan", driver: cruise(target_mps: 15.56)),
    ],
    duration_s: 7.0,
    hash_every: 60,
    expect: [
        speed_at(entity: "car", t_s: 4.0, min: 14.5, max: 16.5),
        metric(entity: "car", name: "distance_m", min: 38.0, max: 44.5),
        // Structural crush 0.69 m (round 8; the any-node max read 0.88).
        crush_depth(entity: "car", min: 0.45, max: 1.5),
        metric(entity: "car", name: "final_health", min: 0.0, max: 0.4),
        total_loss(entity: "car", expected: true),
        components_failed(entity: "car", min: 1, max: 21),
    ],
    expect_pending: [],
)
