// Parity suite: light RWD sports car at 10 mph, steer right + handbrake for 1.0 s, off the
// throttle (clip 2's hairpin pivot). The reference pivots 150–180° in that second (a mean yaw
// rate of ~2.6–3.1 rad/s); expect_pending tracks that target.
(
    name: "parity_shiro_handbrake_10mph",
    mode: Arcade,
    seed: 3,
    assists: custom((abs: true, tcs: false, esc: false, steer_speed_sensitivity: 0.75, countersteer_help: 0.6, throttle_filter: 0.7, brake_filter: 0.6, auto_gears: false, auto_clutch: true)),
    duration_s: 2.5,
    entities: [
        (
            id: "car",
            car: "shiro_turbo",
            speed_mps: 4.47,
            inputs: [
                (t_s: 0.0, input: (steer: 1.0, handbrake: 1.0)),
                (t_s: 1.0, input: ()),
            ],
        ),
    ],
    // Measured 2026-10-20: 0.88 rad/s peak (≈40° in the second).
    expect: [metric(name: "max_yaw_rate_rps", min: 0.4, max: 6.0)],
    expect_pending: [metric(name: "max_yaw_rate_rps", min: 2.6, max: 6.0)],
)
