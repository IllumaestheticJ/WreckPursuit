// Opponent AI pace lock-in (playtest row 99, docs/integration/opponent-pace.md): the
// hollins_sprint race from apps/simcli/scenarios/race/pick_hollins_sprint.ron,
// police off (no patrols, no presence), traffic as in the race, every seat (the player's
// too) driven by wp_opponent at skill 0.95, each seat's picker personality otherwise.
// simcli cannot drive AI racers: run standalone, the cars wait on the grid and the
// `expect_pending` pace metrics stay pending (unknown to simcli).
// crates/wp_race/tests/opponent_pace.rs::pace_scenarios_hold_their_ranges races it (release
// builds) and checks them: `finishers` (every car finishes), `best_ratio` (best time over
// that car's ideal time: its speed profile at 100 % of its measured limits; at most today's
// + 0.05, never under 0.97), `race_time_s` per car (today's time −15 % .. +15 %, +20 % at
// skill 0.50). Measured 2026-10-20 on lead/opponent-pace; re-measured the same day on the
// round-12 tip (today's grids, residential grid city, police give-way; reasons in
// docs/integration/opponent-pace.md). Re-locked 2026-10-21 on ws/police 3bccc796 + ws/harness +
// lead/round12 (one-version handling); reasons in docs/integration/opponent-pace.md. Re-measure and widen only with a reason.
// Re-locked 2026-10-23 by the rule: the judged finish moved 60 m short of the Knob lot
// (lead-approved layout change; the rest of the road is the AI run-off), 941 m instead of
// 1001 m, so every time is about 3-4 s shorter. Reasons in docs/integration/opponent-pace.md.
// 2026-10-23 (D, PR #38 port): spawns re-synced from the regenerated race pick file (the
// Hollins Ascent grid moved across the Hollins Gorge Bridge; Loop 9's by millimetres). Ranges
// unchanged: every time is inside them.
(
    name: "opponent_pace_hollins_sprint_s95",
    seed: 16,
    city: preset(
        name: "vesper_v2",
        seed: 1,
    ),
    time_of_day_h: 23.0,
    time_ratio: 1.0,
    mode: Simulation,
    assists: ai,
    traffic_density: 0.3,
    police_presence: 0.0,
    police_cars: false,
    panels: true,
    entities: [
        (
            id: "player",
            car: "lindwurm_4t",
            pos: (-558.9696, 888.5032, 33.084213),
            yaw: 1.0645496,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_mara",
            car: "hakone_gt",
            pos: (-579.9593, 900.14075, 33.084213),
            yaw: 1.0645496,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_vic",
            car: "kestrel_ts",
            pos: (-572.96277, 896.26154, 33.084213),
            yaw: 1.0645496,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_juno",
            car: "shiro_turbo",
            pos: (-565.9662, 892.3824, 33.084213),
            yaw: 1.0645496,
            driver: scripted,
            inputs: [],
        ),
    ],
    duration_s: 10.0,
    sample_hz: 60.0,
    hash_every: 240,
    expect: [
        total_loss(
            entity: "player",
            expected: false,
        ),
        total_loss(
            entity: "ai_mara",
            expected: false,
        ),
    ],
    expect_pending: [
        metric(name: "finishers", min: 4, max: 4),
        metric(name: "best_ratio", min: 0.97, max: 1.12),
        metric(name: "race_time_s", entity: "ai_mara", min: 49.5, max: 66.9),
        metric(name: "race_time_s", entity: "ai_vic", min: 50.7, max: 68.6),
        metric(name: "race_time_s", entity: "ai_juno", min: 51.8, max: 70.1),
        metric(name: "race_time_s", entity: "player", min: 52.9, max: 71.6),
    ],
)
