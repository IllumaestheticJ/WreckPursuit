// Opponent AI pace lock-in (playtest row 99, docs/integration/opponent-pace.md): the
// hollins_sprint race from apps/simcli/scenarios/race/pick_hollins_sprint.ron,
// police off (no patrols, no presence), traffic as in the race, every seat (the player's
// too) driven by wp_opponent at skill 0.95, each seat's picker personality otherwise.
// simcli cannot drive AI racers: run standalone, the cars wait on the grid and the
// `expect_pending` pace metrics stay pending (unknown to simcli).
// crates/wp_race/tests/opponent_pace.rs::pace_scenarios_hold_their_ranges races it (release
// builds) and checks them: `finishers` (every car finishes), `best_ratio` (best time over
// that car's ideal time: its speed profile at 100 % of its measured limits; at most today's
// + 0.05, never under 0.97), `race_time_s` per car (today's time −15 % .. +15 %, +20 % at
// skill 0.50). Re-measured 2026-10-21 on ws/harness, after lead/city-residential; re-measure
// and widen only with a reason (docs/integration/opponent-pace.md, Re-lock 2026-10-21).
(
    name: "opponent_pace_hollins_sprint_s95",
    seed: 16,
    city: preset(
        name: "vesper_v2",
        seed: 1,
    ),
    time_of_day_h: 23.0,
    time_ratio: 1.0,
    mode: Arcade,
    assists: ai,
    traffic_density: 0.3,
    police_presence: 0.0,
    police_cars: false,
    panels: true,
    entities: [
        (
            id: "player",
            car: "lindwurm_4t",
            pos: (-424.6047, 879.35706, 22.403357),
            yaw: 1.4438996,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_mara",
            car: "hakone_gt",
            pos: (-437.14102, 875.9159, 22.403357),
            yaw: 1.4438996,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_vic",
            car: "kestrel_ts",
            pos: (-432.54037, 880.3695, 22.403357),
            yaw: 1.4438996,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_juno",
            car: "shiro_turbo",
            pos: (-429.20535, 874.90344, 22.403357),
            yaw: 1.4438996,
            driver: scripted,
            inputs: [],
        ),
    ],
    duration_s: 10.0,
    sample_hz: 60.0,
    hash_every: 240,
    expect: [
        total_loss(
            entity: "player",
            expected: false,
        ),
        total_loss(
            entity: "ai_mara",
            expected: false,
        ),
    ],
    expect_pending: [
        metric(name: "finishers", min: 4, max: 4),
        metric(name: "best_ratio", min: 0.97, max: 1.12),
        metric(name: "race_time_s", entity: "ai_mara", min: 50.5, max: 68.5),
        metric(name: "race_time_s", entity: "ai_vic", min: 54.2, max: 73.5),
        metric(name: "race_time_s", entity: "ai_juno", min: 51.8, max: 70.2),
        metric(name: "race_time_s", entity: "player", min: 54.8, max: 74.2),
    ],
)
