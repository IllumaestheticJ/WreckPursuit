// Opponent AI pace lock-in (playtest row 99, docs/integration/opponent-pace.md): the
// loop9_circuit race from apps/simcli/scenarios/race/pick_loop9_circuit.ron,
// police off (no patrols, no presence), traffic as in the race, every seat (the player's
// too) driven by wp_opponent at skill 0.95, each seat's picker personality otherwise.
// simcli cannot drive AI racers: run standalone, the cars wait on the grid and the
// `expect_pending` pace metrics stay pending (unknown to simcli).
// crates/wp_race/tests/opponent_pace.rs::pace_scenarios_hold_their_ranges races it (release
// builds) and checks them: `finishers` (every car finishes), `best_ratio` (best time over
// that car's ideal time: its speed profile at 100 % of its measured limits; at most today's
// + 0.05, never under 0.97), `race_time_s` per car (today's time −15 % .. +15 %, +20 % at
// skill 0.50). Measured 2026-10-20 on lead/opponent-pace; re-measured the same day on the
// round-12 tip (today's grids, residential grid city, police give-way; reasons in
// docs/integration/opponent-pace.md). Re-locked 2026-10-21 on ws/police 3bccc796 + ws/harness +
// lead/round12 4367d42e (one-version handling). `finishers` min 5 and no ai_mara time:
// hakone_gt does not finish on the one-version handling (reproduces on plain round12; at
// 55-60 m/s it cannot hold its line's lateral g, drifts wide, brakes mid-bend and the rear
// lets go). Restore min 6 with the speed-dependent lateral capability (opponent-pace.md).
// Re-measure and widen only with a reason.
(
    name: "opponent_pace_loop9_circuit_s95",
    seed: 9,
    city: preset(
        name: "vesper_v2",
        seed: 1,
    ),
    time_of_day_h: 1.0,
    time_ratio: 1.0,
    mode: Arcade,
    assists: ai,
    traffic_density: 0.3,
    police_presence: 0.0,
    police_cars: false,
    panels: true,
    entities: [
        (
            id: "player",
            car: "lindwurm_4t",
            pos: (328.56927, 1419.1766, 23.714773),
            yaw: 1.6529424,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_vic",
            car: "kestrel_ts",
            pos: (309.047, 1412.5524, 23.714773),
            yaw: 1.6529424,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_mara",
            car: "hakone_gt",
            pos: (312.62323, 1417.8636, 23.714773),
            yaw: 1.6529424,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_dez",
            car: "rampart_50",
            pos: (317.02002, 1413.2087, 23.714773),
            yaw: 1.6529424,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_juno",
            car: "shiro_turbo",
            pos: (320.59625, 1418.5201, 23.714773),
            yaw: 1.6529424,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_tito",
            car: "sperber_32",
            pos: (324.99304, 1413.8652, 23.714773),
            yaw: 1.6529424,
            driver: scripted,
            inputs: [],
        ),
    ],
    duration_s: 10.0,
    sample_hz: 60.0,
    hash_every: 240,
    expect: [
        total_loss(
            entity: "player",
            expected: false,
        ),
        total_loss(
            entity: "ai_vic",
            expected: false,
        ),
    ],
    expect_pending: [
        metric(name: "finishers", min: 5, max: 6),
        metric(name: "best_ratio", min: 0.97, max: 1.2),
        metric(name: "race_time_s", entity: "ai_vic", min: 166.9, max: 225.8),
        metric(name: "race_time_s", entity: "ai_dez", min: 168.1, max: 227.5),
        metric(name: "race_time_s", entity: "ai_juno", min: 169.9, max: 229.9),
        metric(name: "race_time_s", entity: "ai_tito", min: 171.5, max: 232.0),
        metric(name: "race_time_s", entity: "player", min: 170.7, max: 230.9),
    ],
)
