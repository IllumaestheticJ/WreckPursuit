// Opponent AI pace lock-in (playtest row 99, docs/integration/opponent-pace.md): the
// grid_highway_sprint race from apps/simcli/scenarios/race/pick_grid_highway_sprint.ron,
// police off (no patrols, no presence), traffic as in the race, every seat (the player's
// too) driven by wp_opponent at skill 0.50, each seat's picker personality otherwise.
// simcli cannot drive AI racers: run standalone, the cars wait on the grid and the
// `expect_pending` pace metrics stay pending (unknown to simcli).
// crates/wp_race/tests/opponent_pace.rs::pace_scenarios_hold_their_ranges races it (release
// builds) and checks them: `finishers` (every car finishes), `best_ratio` (best time over
// that car's ideal time: its speed profile at 100 % of its measured limits; at most today's
// + 0.05, never under 0.97), `race_time_s` per car (today's time −15 % .. +15 %, +20 % at
// skill 0.50). Measured 2026-10-20 on lead/opponent-pace; re-measured the same day on the
// round-12 tip (today's grids, residential grid city, police give-way; reasons in
// docs/integration/opponent-pace.md). Re-locked 2026-10-21 on ws/police 3bccc796 + ws/harness +
// lead/round12 (one-version handling); reasons in docs/integration/opponent-pace.md. Re-measure and widen only with a reason.
// Re-locked 2026-10-21 on lead/main-sync: main's grid moved the race to the divided viaduct
// (start y = -728, 1113 m); the old grid stood on round 12's street and nobody finished.
// Re-locked again on the tip with lead/opponent-pace 70ab9d0 (gap planner).
// Re-locked 2026-10-22 when the pace harness moved to the browser setup (the player seat stays
// a player car, AI-driven, so traffic spawns round it): best ratio 1.299 -> 1.543, field
// slower (measured; the cause in the traffic
// around the player car was not traced).
// best_ratio 1.59 -> 1.64 (2026-10-22): 1.593 today after physical traffic cars are seen as traffic
// (one perception per car); the seeds 1-8 field mean moved +0.4 s.
// best_ratio 1.64 -> 1.65 (2026-10-25, traffic hard impacts): main c65ad938 measures 1.6400
// (ai_vic 48.8245 s), right on the bound; with struck traffic cars now staying stopped ai_vic
// takes 48.8277 s (+3 ms) and tips over it. Same field, same order.
// Re-locked 2026-10-25 (PR #94, RaceConfig::ram_traffic on the trained racers, main 244023bf):
// ai_juno no longer queues behind highway traffic, 34.4 s (was locked round 46.8), the rule
// (-15 % .. +20 %) on today's time. The other three are in range and keep their locks.
(
    name: "opponent_pace_grid_highway_sprint_s50",
    seed: 7,
    city: procedural(
        seed: 1,
        blocks_x: 12,
        blocks_y: 12,
        block_m: 110.0,
    ),
    time_of_day_h: 23.0,
    time_ratio: 1.0,
    mode: Simulation,
    assists: ai,
    traffic_density: 0.3,
    police_presence: 0.0,
    police_cars: false,
    panels: true,
    entities: [
        (
            id: "player",
            car: "lindwurm_4t",
            pos: (13.25, -728.25024, 0.0),
            yaw: 0.0,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_vic",
            car: "kestrel_ts",
            pos: (8.25, -716.25024, 0.0),
            yaw: 0.0,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_juno",
            car: "shiro_turbo",
            pos: (13.25, -720.25024, 0.0),
            yaw: 0.0,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_tito",
            car: "sperber_32",
            pos: (8.25, -724.25024, 0.0),
            yaw: 0.0,
            driver: scripted,
            inputs: [],
        ),
    ],
    duration_s: 10.0,
    sample_hz: 60.0,
    hash_every: 240,
    expect: [
        total_loss(
            entity: "player",
            expected: false,
        ),
        total_loss(
            entity: "ai_vic",
            expected: false,
        ),
    ],
    expect_pending: [
        metric(name: "finishers", min: 4, max: 4),
        metric(name: "best_ratio", min: 0.97, max: 1.65),
        metric(name: "race_time_s", entity: "ai_vic", min: 38.8, max: 54.8),
        metric(name: "race_time_s", entity: "ai_juno", min: 29.2, max: 41.2),
        metric(name: "race_time_s", entity: "ai_tito", min: 38.5, max: 54.4),
        metric(name: "race_time_s", entity: "player", min: 40.6, max: 57.4),
    ],
)
