// Opponent AI pace lock-in (playtest row 99, docs/integration/opponent-pace.md): the
// loop9_circuit race from apps/simcli/scenarios/race/pick_loop9_circuit.ron,
// police off (no patrols, no presence), traffic as in the race, every seat (the player's
// too) driven by wp_opponent at skill 0.50, each seat's picker personality otherwise.
// simcli cannot drive AI racers: run standalone, the cars wait on the grid and the
// `expect_pending` pace metrics stay pending (unknown to simcli).
// crates/wp_race/tests/opponent_pace.rs::pace_scenarios_hold_their_ranges races it (release
// builds) and checks them: `finishers` (every car finishes), `best_ratio` (best time over
// that car's ideal time: its speed profile at 100 % of its measured limits; at most today's
// + 0.05, never under 0.97), `race_time_s` per car (today's time −15 % .. +15 %, +20 % at
// skill 0.50). Measured 2026-10-20 on lead/opponent-pace; re-measured the same day on the
// round-12 tip (today's grids, residential grid city, police give-way; reasons in
// docs/integration/opponent-pace.md). Re-locked 2026-10-21 on ws/police 3bccc796 + ws/harness +
// lead/round12 (one-version handling); reasons in docs/integration/opponent-pace.md.
// No `finishers` here (2026-10-22, lead): at 23:00 / density 2.0 one seed's finishers swing by
// ±3 cars on millimetre differences; the gate is `loop9_traffic_field_finishes` (>= 44/48 over
// seeds 1-8, `just pace-loop9`). The times of the cars that finish are still checked.
// Re-measure and widen only with a reason.
// Widened 2026-10-22 (lead): one seed at 23:00 / density 2.0 swings by 30-80 s on traffic
// draw alone (opponent-pace.md, "Loop 9 s95 slowdown, bisected"), so this seed only catches
// gross breakage: today's time −40 % .. +40 %, best_ratio at most today's × 1.4. Loop 9's pace
// lock is the 8-seed mean in `loop9_traffic_field_finishes` (`just pace-loop9`).
(
    name: "opponent_pace_loop9_circuit_s50",
    seed: 9,
    city: preset(
        name: "vesper_v2",
        seed: 1,
    ),
    time_of_day_h: 23.0,
    time_ratio: 1.0,
    mode: Arcade,
    assists: ai,
    traffic_density: 2.0,
    police_presence: 0.0,
    police_cars: false,
    panels: true,
    entities: [
        (
            id: "player",
            car: "lindwurm_4t",
            pos: (328.56927, 1419.1766, 23.714773),
            yaw: 1.6529424,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_vic",
            car: "kestrel_ts",
            pos: (309.047, 1412.5524, 23.714773),
            yaw: 1.6529424,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_mara",
            car: "hakone_gt",
            pos: (312.62323, 1417.8636, 23.714773),
            yaw: 1.6529424,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_dez",
            car: "rampart_50",
            pos: (317.02002, 1413.2087, 23.714773),
            yaw: 1.6529424,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_juno",
            car: "shiro_turbo",
            pos: (320.59625, 1418.5201, 23.714773),
            yaw: 1.6529424,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_tito",
            car: "sperber_32",
            pos: (324.99304, 1413.8652, 23.714773),
            yaw: 1.6529424,
            driver: scripted,
            inputs: [],
        ),
    ],
    duration_s: 10.0,
    sample_hz: 60.0,
    hash_every: 240,
    expect: [
        total_loss(
            entity: "player",
            expected: false,
        ),
        total_loss(
            entity: "ai_vic",
            expected: false,
        ),
    ],
    expect_pending: [
        metric(name: "best_ratio", min: 0.97, max: 1.71),
        metric(name: "race_time_s", entity: "ai_vic", min: 158.8, max: 370.6),
        metric(name: "race_time_s", entity: "ai_mara", min: 120.5, max: 281.2),
        metric(name: "race_time_s", entity: "ai_dez", min: 132.1, max: 308.3),
        metric(name: "race_time_s", entity: "ai_juno", min: 159.5, max: 372.1),
        metric(name: "race_time_s", entity: "ai_tito", min: 160.1, max: 373.6),
        metric(name: "race_time_s", entity: "player", min: 154.0, max: 359.2),
    ],
)
