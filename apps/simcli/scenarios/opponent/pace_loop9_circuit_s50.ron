// Opponent AI pace lock-in (playtest row 99, docs/integration/opponent-pace.md): the
// loop9_circuit race from apps/simcli/scenarios/race/pick_loop9_circuit.ron,
// police off (no patrols, no presence), traffic as in the race, every seat (the player's
// too) driven by wp_opponent at skill 0.50, each seat's picker personality otherwise.
// simcli cannot drive AI racers: run standalone, the cars wait on the grid and the
// `expect_pending` pace metrics stay pending (unknown to simcli).
// crates/wp_race/tests/opponent_pace.rs::pace_scenarios_hold_their_ranges races it (release
// builds) and checks them: `finishers` (every car finishes), `best_ratio` (best time over
// that car's ideal time: its speed profile at 100 % of its measured limits; at most today's
// + 0.05, never under 0.97), `race_time_s` per car (today's time −15 % .. +15 %, +20 % at
// skill 0.50). Re-measured 2026-10-21 on ws/harness, after lead/city-residential; re-measure
// and widen only with a reason (docs/integration/opponent-pace.md, Re-lock 2026-10-21).
(
    name: "opponent_pace_loop9_circuit_s50",
    seed: 9,
    city: preset(
        name: "vesper_v2",
        seed: 1,
    ),
    time_of_day_h: 1.0,
    time_ratio: 1.0,
    mode: Simulation,
    assists: ai,
    traffic_density: 0.3,
    police_presence: 0.0,
    police_cars: false,
    panels: true,
    entities: [
        (
            id: "player",
            car: "lindwurm_4t",
            pos: (328.56915, 1419.1772, 23.715237),
            yaw: 1.6529646,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_vic",
            car: "kestrel_ts",
            pos: (309.04703, 1412.5525, 23.715237),
            yaw: 1.6529646,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_mara",
            car: "hakone_gt",
            pos: (312.62314, 1417.864, 23.715237),
            yaw: 1.6529646,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_dez",
            car: "rampart_50",
            pos: (317.02005, 1413.2091, 23.715237),
            yaw: 1.6529646,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_juno",
            car: "shiro_turbo",
            pos: (320.59616, 1418.5206, 23.715237),
            yaw: 1.6529646,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_tito",
            car: "sperber_32",
            pos: (324.99304, 1413.8657, 23.715237),
            yaw: 1.6529646,
            driver: scripted,
            inputs: [],
        ),
    ],
    duration_s: 10.0,
    sample_hz: 60.0,
    hash_every: 240,
    expect: [
        total_loss(
            entity: "player",
            expected: false,
        ),
        total_loss(
            entity: "ai_vic",
            expected: false,
        ),
    ],
    expect_pending: [
        metric(name: "finishers", min: 6, max: 6),
        metric(name: "best_ratio", min: 0.97, max: 1.23),
        metric(name: "race_time_s", entity: "ai_vic", min: 170.3, max: 240.6),
        metric(name: "race_time_s", entity: "ai_mara", min: 161.3, max: 227.8),
        metric(name: "race_time_s", entity: "ai_dez", min: 171.0, max: 241.5),
        metric(name: "race_time_s", entity: "ai_juno", min: 173.2, max: 244.6),
        metric(name: "race_time_s", entity: "ai_tito", min: 175.7, max: 248.2),
        metric(name: "race_time_s", entity: "player", min: 174.7, max: 246.7),
    ],
)
