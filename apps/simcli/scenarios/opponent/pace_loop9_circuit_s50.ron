// Opponent AI pace lock-in (playtest row 99, docs/integration/opponent-pace.md): the
// loop9_circuit race from apps/simcli/scenarios/race/pick_loop9_circuit.ron,
// police off (no patrols, no presence), traffic as in the race, every seat (the player's
// too) driven by wp_opponent at skill 0.50, each seat's picker personality otherwise.
// simcli cannot drive AI racers: run standalone, the cars wait on the grid and the
// `expect_pending` pace metrics stay pending (unknown to simcli).
// crates/wp_race/tests/opponent_pace.rs::pace_scenarios_hold_their_ranges races it (release
// builds) and checks them: `finishers` (every car finishes), `best_ratio` (best time over
// that car's ideal time: its speed profile at 100 % of its measured limits; at most today's
// + 0.05, never under 0.97), `race_time_s` per car (today's time −15 % .. +15 %, +20 % at
// skill 0.50). Measured 2026-10-20 on lead/opponent-pace; re-measure and widen only with a
// reason (docs/integration/opponent-pace.md).
(
    name: "opponent_pace_loop9_circuit_s50",
    seed: 9,
    city: preset(
        name: "vesper_v2",
        seed: 1,
    ),
    time_of_day_h: 1.0,
    time_ratio: 1.0,
    mode: Arcade,
    assists: ai,
    traffic_density: 0.3,
    police_presence: 0.0,
    police_cars: false,
    panels: true,
    entities: [
        (
            id: "player",
            car: "lindwurm_4t",
            pos: (328.69238, 1417.6816, 23.712965),
            yaw: 1.6529424,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_vic",
            car: "kestrel_ts",
            pos: (309.1701, 1411.0574, 23.712965),
            yaw: 1.6529424,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_mara",
            car: "hakone_gt",
            pos: (312.74634, 1416.3687, 23.712965),
            yaw: 1.6529424,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_dez",
            car: "rampart_50",
            pos: (317.14313, 1411.7137, 23.712965),
            yaw: 1.6529424,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_juno",
            car: "shiro_turbo",
            pos: (320.71936, 1417.0251, 23.712965),
            yaw: 1.6529424,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_tito",
            car: "sperber_32",
            pos: (325.11615, 1412.3702, 23.712965),
            yaw: 1.6529424,
            driver: scripted,
            inputs: [],
        ),
    ],
    duration_s: 10.0,
    sample_hz: 60.0,
    hash_every: 240,
    expect: [
        total_loss(
            entity: "player",
            expected: false,
        ),
        total_loss(
            entity: "ai_vic",
            expected: false,
        ),
    ],
    expect_pending: [
        metric(name: "finishers", min: 6, max: 6),
        metric(name: "best_ratio", min: 0.97, max: 1.25),
        metric(name: "race_time_s", entity: "ai_vic", min: 183.4, max: 259.0),
        metric(name: "race_time_s", entity: "ai_mara", min: 184.4, max: 260.5),
        metric(name: "race_time_s", entity: "ai_dez", min: 193.2, max: 272.9),
        metric(name: "race_time_s", entity: "ai_juno", min: 202.1, max: 285.4),
        metric(name: "race_time_s", entity: "ai_tito", min: 203.2, max: 286.9),
        metric(name: "race_time_s", entity: "player", min: 191.6, max: 270.7),
    ],
)
