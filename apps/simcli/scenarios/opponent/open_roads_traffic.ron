// Opponent AI (workstream 17). Runs today on the flat world with a warning: simcli does not
// yet load procedural cities or drive `follow_route` entities. Once machine I wires
// `follow_route` to `wp_opponent::Field` (request in docs/integration/opponent.md), the
// pending expectations become the real check. Entity ids name the driver's skill
// (`skillNN` = DriverProfile { skill: 0.NN, ..default }); `target_speed: 0.0` = race pace.
// The same race runs today as a Rust test: crates/wp_opponent/tests/race.rs.
(
    name: "opponent_open_roads_traffic",
    seed: 7,
    city: procedural(seed: 1, blocks_x: 7, blocks_y: 7, block_m: 110.0),
    mode: Arcade,
    assists: ai,
    traffic_density: 0.25,
    entities: [
        (id: "skill95", car: "debug_sedan", pos: (-104.0, -166.75, 0.0), yaw: -1.5708, assists: ai,
         driver: follow_route(route_id: "procedural_8x8/arterial_square_ccw", target_speed: 0.0)),
        (id: "skill85", car: "debug_sedan", pos: (-112.2, -166.75, 0.0), yaw: -1.5708, assists: ai,
         driver: follow_route(route_id: "procedural_8x8/arterial_square_ccw", target_speed: 0.0)),
        (id: "skill75", car: "debug_sedan", pos: (-120.4, -166.75, 0.0), yaw: -1.5708, assists: ai,
         driver: follow_route(route_id: "procedural_8x8/arterial_square_ccw", target_speed: 0.0)),
        (id: "skill65", car: "debug_sedan", pos: (-128.6, -166.75, 0.0), yaw: -1.5708, assists: ai,
         driver: follow_route(route_id: "procedural_8x8/arterial_square_ccw", target_speed: 0.0)),
    ],
    duration_s: 90.0,
    hash_every: 2400,
    expect: [event_count(event: "TotalLoss", min: 0, max: 0)],
    expect_pending: [
        // Open roads, civilian traffic: no civilian ever touched (a DQ), everyone gets
        // round the first corners.
        event_count(event: "Contact", min: 0, max: 4),
        metric(entity: "skill65", name: "path_length_m", min: 250.0, max: 2000.0),
    ],
)
