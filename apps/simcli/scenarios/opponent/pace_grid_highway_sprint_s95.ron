// Opponent AI pace lock-in (playtest row 99, docs/integration/opponent-pace.md): the
// grid_highway_sprint race from apps/simcli/scenarios/race/pick_grid_highway_sprint.ron,
// police off (no patrols, no presence), traffic as in the race, every seat (the player's
// too) driven by wp_opponent at skill 0.95, each seat's picker personality otherwise.
// simcli cannot drive AI racers: run standalone, the cars wait on the grid and the
// `expect_pending` pace metrics stay pending (unknown to simcli).
// crates/wp_race/tests/opponent_pace.rs::pace_scenarios_hold_their_ranges races it (release
// builds) and checks them: `finishers` (every car finishes), `best_ratio` (best time over
// that car's ideal time: its speed profile at 100 % of its measured limits; at most today's
// + 0.05, never under 0.97), `race_time_s` per car (today's time −15 % .. +15 %, +20 % at
// skill 0.50). Re-measured 2026-10-21 on ws/harness, after the merge with main's highway
// layout; re-measure and widen only with a reason (docs/integration/opponent-pace.md,
// Re-lock after the main merge).
(
    name: "opponent_pace_grid_highway_sprint_s95",
    seed: 7,
    city: procedural(
        seed: 1,
        blocks_x: 12,
        blocks_y: 12,
        block_m: 110.0,
    ),
    time_of_day_h: 23.0,
    time_ratio: 1.0,
    mode: Simulation,
    assists: ai,
    traffic_density: 0.3,
    police_presence: 0.0,
    police_cars: false,
    panels: true,
    entities: [
        (
            id: "player",
            car: "lindwurm_4t",
            pos: (13.25, -727.0123, 0.0),
            yaw: 0.0,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_vic",
            car: "kestrel_ts",
            pos: (8.25, -715.0123, 0.0),
            yaw: 0.0,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_juno",
            car: "shiro_turbo",
            pos: (13.25, -719.0123, 0.0),
            yaw: 0.0,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_tito",
            car: "sperber_32",
            pos: (8.25, -723.0123, 0.0),
            yaw: 0.0,
            driver: scripted,
            inputs: [],
        ),
    ],
    duration_s: 10.0,
    sample_hz: 60.0,
    hash_every: 240,
    expect: [
        total_loss(
            entity: "player",
            expected: false,
        ),
        total_loss(
            entity: "ai_vic",
            expected: false,
        ),
    ],
    expect_pending: [
        metric(name: "finishers", min: 4, max: 4),
        metric(name: "best_ratio", min: 0.97, max: 1.30),
        metric(name: "race_time_s", entity: "ai_vic", min: 31.5, max: 42.6),
        metric(name: "race_time_s", entity: "ai_juno", min: 33.9, max: 45.9),
        metric(name: "race_time_s", entity: "ai_tito", min: 34.9, max: 47.2),
        metric(name: "race_time_s", entity: "player", min: 37.3, max: 50.4),
    ],
)
