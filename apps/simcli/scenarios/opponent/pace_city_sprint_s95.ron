// Opponent AI pace lock-in (playtest row 99, docs/integration/opponent-pace.md): the
// city_sprint race from apps/simcli/scenarios/race/city_sprint_police.ron,
// police off (no patrols, no presence), traffic as in the race, every seat (the player's
// too) driven by wp_opponent at skill 0.95, each seat's picker personality otherwise.
// simcli cannot drive AI racers: run standalone, the cars wait on the grid and the
// `expect_pending` pace metrics stay pending (unknown to simcli).
// crates/wp_race/tests/opponent_pace.rs::pace_scenarios_hold_their_ranges races it (release
// builds) and checks them: `finishers` (every car finishes), `best_ratio` (best time over
// that car's ideal time: its speed profile at 100 % of its measured limits; at most today's
// + 0.05, never under 0.97), `race_time_s` per car (today's time −15 % .. +15 %, +20 % at
// skill 0.50). Re-measured 2026-10-21 on ws/harness, after the merge with main's highway
// layout; re-measure and widen only with a reason (docs/integration/opponent-pace.md,
// Re-lock after the main merge).
(
    name: "opponent_pace_city_sprint_s95",
    // Slowest city runs in the test pass (round 8): skipped by debug `cargo test`, run by the
    // release CI jobs (`simcli determinism`, `simcli goldens`).
    slow: true,
    seed: 5,
    city: procedural(seed: 1, blocks_x: 7, blocks_y: 7, block_m: 110.0),
    time_of_day_h: 13.0,
    mode: Simulation,
    assists: ai,
    traffic_density: 0.3,
    police_presence: 0.0,
    police_cars: false,
    // Parked cars make debug test runs very slow and take no part in the race.
    parked_cars: false,
    entities: [
        (id: "ai_coupe", car: "debug_coupe", pos: (58.05, -440.0, 0.0)),
        (id: "ai_sedan", car: "debug_sedan", pos: (63.05, -444.0, 0.0)),
        (id: "ai_coupe_2", car: "debug_coupe", pos: (58.05, -448.0, 0.0)),
        (id: "ai_sedan_2", car: "debug_sedan", pos: (63.05, -452.0, 0.0)),
    ],
    duration_s: 30.0,
    hash_every: 240,
    expect: [
        total_loss(entity: "ai_coupe", expected: false),
        total_loss(entity: "ai_sedan", expected: false),
    ],
    expect_pending: [
        metric(name: "finishers", min: 4, max: 4),
        metric(name: "best_ratio", min: 0.97, max: 1.04),
        metric(name: "race_time_s", entity: "ai_coupe", min: 8.0, max: 10.8),
        metric(name: "race_time_s", entity: "ai_sedan", min: 9.6, max: 13.0),
        metric(name: "race_time_s", entity: "ai_coupe_2", min: 8.7, max: 11.7),
        metric(name: "race_time_s", entity: "ai_sedan_2", min: 10.4, max: 14.1),
    ],
)
