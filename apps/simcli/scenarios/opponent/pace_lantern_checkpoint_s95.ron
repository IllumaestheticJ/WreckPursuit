// Opponent AI pace lock-in (playtest row 99, docs/integration/opponent-pace.md): the
// lantern_checkpoint race from apps/simcli/scenarios/race/pick_lantern_checkpoint.ron,
// police off (no patrols, no presence), traffic as in the race, every seat (the player's
// too) driven by wp_opponent at skill 0.95, each seat's picker personality otherwise.
// simcli cannot drive AI racers: run standalone, the cars wait on the grid and the
// `expect_pending` pace metrics stay pending (unknown to simcli).
// crates/wp_race/tests/opponent_pace.rs::pace_scenarios_hold_their_ranges races it (release
// builds) and checks them: `finishers` (every car finishes), `best_ratio` (best time over
// that car's ideal time: its speed profile at 100 % of its measured limits; at most today's
// + 0.05, never under 0.97), `race_time_s` per car (today's time −15 % .. +15 %, +20 % at
// skill 0.50). Re-measured 2026-10-23 after the bolder-racer change (racers squeeze past
// traffic: 73-78 s, was 87-141 s); re-measure and widen only with a reason
// (docs/integration/opponent.md, Bolder AI racers).
(
    name: "opponent_pace_lantern_checkpoint_s95",
    seed: 31,
    city: preset(
        name: "vesper_v2",
        seed: 1,
    ),
    time_of_day_h: 14.0,
    time_ratio: 1.0,
    mode: Simulation,
    assists: ai,
    traffic_density: 0.2,
    police_presence: 0.0,
    police_cars: false,
    panels: true,
    entities: [
        (
            id: "player",
            car: "lindwurm_4t",
            pos: (-1.75, 257.0, 13.628593),
            yaw: 3.1415927,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_juno",
            car: "shiro_turbo",
            pos: (-1.75, 233.0, 13.628593),
            yaw: 3.1415927,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_dez",
            car: "rampart_50",
            pos: (-1.75, 241.0, 13.628593),
            yaw: 3.1415927,
            driver: scripted,
            inputs: [],
        ),
        (
            id: "ai_tito",
            car: "sperber_32",
            pos: (-1.75, 249.0, 13.628593),
            yaw: 3.1415927,
            driver: scripted,
            inputs: [],
        ),
    ],
    duration_s: 10.0,
    sample_hz: 60.0,
    hash_every: 240,
    expect: [
        total_loss(
            entity: "player",
            expected: false,
        ),
        total_loss(
            entity: "ai_juno",
            expected: false,
        ),
    ],
    expect_pending: [
        metric(name: "finishers", min: 4, max: 4),
        metric(name: "best_ratio", min: 0.97, max: 2.09),
        metric(name: "race_time_s", entity: "ai_juno", min: 62.5, max: 84.6),
        metric(name: "race_time_s", entity: "ai_dez", min: 62.7, max: 84.8),
        metric(name: "race_time_s", entity: "ai_tito", min: 64.0, max: 86.6),
        metric(name: "race_time_s", entity: "player", min: 65.9, max: 89.2),
    ],
)
