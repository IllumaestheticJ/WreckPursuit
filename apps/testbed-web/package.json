{
  "name": "wp-testbed-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../../crates/wp_wasm --target web --out-dir ../../apps/testbed-web/src/wasm/pkg --dev",
    "wasm:release": "wasm-pack build ../../crates/wp_wasm --target web --out-dir ../../apps/testbed-web/src/wasm/pkg --release",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
