{
  "name": "wp-testbed-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../../crates/wp_wasm --target web --out-dir ../../apps/testbed-web/src/wasm/pkg --release",
    "wasm:dev": "wasm-pack build ../../crates/wp_wasm --target web --out-dir ../../apps/testbed-web/src/wasm/pkg --dev",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/run.mjs && node e2e/race.mjs && node e2e/countersteer.mjs && node e2e/radio.mjs && node e2e/siren.mjs && node e2e/tune.mjs",
    "e2e:radio": "node e2e/radio.mjs",
    "e2e:siren": "node e2e/siren.mjs",
    "e2e:spikes": "node e2e/spikes.mjs",
    "e2e:cameras": "node e2e/cameras.mjs",
    "e2e:photo": "node e2e/photo.mjs",
    "e2e:audio-samples": "node e2e/audio_samples.mjs",
    "e2e:siren-samples": "node e2e/siren_samples.mjs",
    "e2e:audio-mix": "node e2e/audio_mix.mjs",
    "e2e:weather": "node e2e/weather.mjs",
    "e2e:net": "node e2e/net_two_tabs.mjs",
    "e2e:race": "node e2e/race.mjs",
    "e2e:touge": "node e2e/touge.mjs",
    "e2e:tune": "node e2e/tune.mjs",
    "e2e:race-spots": "node e2e/race_spots.mjs",
    "e2e:garages": "node e2e/garages.mjs",
    "e2e:crash-replay": "node e2e/crash_replay.mjs",
    "e2e:perf": "node e2e/perf_check.mjs",
    "e2e:fx": "node e2e/crash_fx.mjs",
    "e2e:gamepad": "node e2e/gamepad.mjs",
    "e2e:reset": "node e2e/reset.mjs",
    "e2e:touch": "node e2e/touch.mjs",
    "e2e:menu": "node e2e/menu.mjs",
    "e2e:hud": "node e2e/hud_debug.mjs",
    "profile": "node e2e/frame_profile.mjs",
    "e2e:presets": "node e2e/presets.mjs",
    "e2e:drift-lab-w": "node e2e/drift_lab_w.mjs",
    "e2e:controls": "node e2e/controls_settings.mjs",
    "e2e:police": "node e2e/police_tools.mjs",
    "e2e:brake-dive": "node e2e/brake_dive.mjs",
    "e2e:signals": "node e2e/signals.mjs",
    "e2e:traffic-bodies": "node e2e/traffic_bodies.mjs"
  },
  "dependencies": {
    "three": "0.180.0",
    "preact": "10.27.2"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
